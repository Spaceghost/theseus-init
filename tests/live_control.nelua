## cflags '-D_GNU_SOURCE'

-- Black-box control socket regression tests and a SIGTERM-resistant child.

require 'arg'
require 'io'
require 'os'
require 'string'

local function c_socket(domain: cint, kind: cint, protocol: cint): cint <cimport 'socket', nodecl, cinclude '<sys/socket.h>'> end
local function c_bind(fd: cint, address: pointer, length: cuint): cint <cimport 'bind', nodecl, cinclude '<sys/socket.h>'> end
local function c_listen(fd: cint, backlog: cint): cint <cimport 'listen', nodecl, cinclude '<sys/socket.h>'> end
local function c_accept(fd: cint, address: pointer, length: pointer): cint <cimport 'accept', nodecl, cinclude '<sys/socket.h>'> end
local function c_usleep(delay: cuint): cint <cimport 'usleep', nodecl, cinclude '<unistd.h>'> end
local function c_connect(fd: cint, address: pointer, length: cuint): cint <cimport 'connect', nodecl, cinclude '<sys/socket.h>'> end
local function c_shutdown(fd: cint, how: cint): cint <cimport 'shutdown', nodecl, cinclude '<sys/socket.h>'> end
local function c_close(fd: cint): cint <cimport 'close', nodecl, cinclude '<unistd.h>'> end
local function c_read(fd: cint, buffer: pointer, count: csize): clong <cimport 'read', nodecl, cinclude '<unistd.h>'> end
local function c_write(fd: cint, buffer: pointer, count: csize): clong <cimport 'write', nodecl, cinclude '<unistd.h>'> end
local function c_pause(): cint <cimport 'pause', nodecl, cinclude '<unistd.h>'> end
local function c_fork(): cint <cimport 'fork', nodecl, cinclude '<unistd.h>'> end
local function c_waitpid(pid: cint, status: *cint, options: cint): cint <cimport 'waitpid', nodecl, cinclude '<sys/wait.h>'> end
local function c_exit(status: cint): void <cimport '_exit', nodecl, cinclude '<unistd.h>'> end
local function c_setsid(): cint <cimport 'setsid', nodecl, cinclude '<unistd.h>'> end
local function c_getpid(): cint <cimport 'getpid', nodecl, cinclude '<unistd.h>'> end
local SignalHandler = @function(cint): void
local function c_signal(signal: cint, handler: SignalHandler): SignalHandler <cimport 'signal', nodecl, cinclude '<signal.h>'> end
local StopSigset: type <cimport 'sigset_t', nodecl, cinclude '<signal.h>'> = @record{}
local function c_sigemptyset(set: *StopSigset): cint <cimport 'sigemptyset', nodecl, cinclude '<signal.h>'> end
local function c_sigaddset(set: *StopSigset, signal: cint): cint <cimport 'sigaddset', nodecl, cinclude '<signal.h>'> end
local function c_sigprocmask(how: cint, set: *StopSigset, old: *StopSigset): cint <cimport 'sigprocmask', nodecl, cinclude '<signal.h>'> end
local function c_sigwait(set: *StopSigset, signal: *cint): cint <cimport 'sigwait', nodecl, cinclude '<signal.h>'> end
local SIG_BLOCK: cint <cimport, nodecl, cinclude '<signal.h>'>
local AF_UNIX: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_STREAM: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_NONBLOCK: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local errno: cint <cimport, nodecl, cinclude '<errno.h>'>
local EAGAIN: cint <cimport, nodecl, cinclude '<errno.h>'>
local SHUT_RD: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SIGTERM: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIG_IGN: SignalHandler <cimport, nodecl, cinclude '<signal.h>'>
local SIG_ERR: SignalHandler <cimport, nodecl, cinclude '<signal.h>'>
local POLLIN: cshort <cimport, nodecl, cinclude '<poll.h>'>
local Pollfd = @record{fd: cint, events: cshort, revents: cshort}
local function c_poll(fds: *Pollfd, count: culong, timeout_ms: cint): cint <cimport 'poll', nodecl, cinclude '<poll.h>'> end
local SockaddrUn = @record{sun_family: cushort, sun_path: [108]cchar}

local function endpoint(path: string): SockaddrUn
  assert(#path > 0 and #path <= 107, 'test socket path length out of range')
  local address: SockaddrUn = {sun_family = (@cushort)(AF_UNIX)}
  for i: isize = 1, #path do address.sun_path[i - 1] = (@cchar)(string.byte(path, i)) end
  return address
end

local function connect(): cint
  local path = os.getenv('THESEUS_SOCKET')
  local address = endpoint(path)
  local fd = c_socket(AF_UNIX, SOCK_STREAM, 0)
  assert(fd >= 0, 'socket failed')
  assert(c_connect(fd, &address, (@cuint)(2 + #path + 1)) == 0, 'connect failed')
  return fd
end

local function send(fd: cint, request: string)
  assert(c_write(fd, (@cstring)(request), (@csize)(#request)) == #request, 'test write failed')
end

local function expect_status(fd: cint)
  local event: Pollfd = {fd = fd, events = POLLIN}
  local buffer: [255]cchar
  local used: integer = 0
  while used < 255 do
    assert(c_poll(&event, 1, 750) == 1, 'control request stalled')
    local got = c_read(fd, &buffer[used], (@csize)(255 - used))
    assert(got > 0, 'no status response')
    used = used + got
    if buffer[used - 1] == 10 then
      local line: string = {data = &buffer[0], size = (@usize)(used)}
      assert(string.find(line, 'TR1\tSTATUS\tsleep-stop\tRUNNING\t', 1, true) == 1,
            'unexpected status response')
      return
    end
  end
  assert(false, 'oversized status response')
end

local function wait_for_file(path: string)
  while true do
    local file = io.open(path, 'r')
    if file:isopen() then file:close(); return end
    c_usleep(10000)
  end
end

if arg[1] == 'probe-gate' or arg[1] == 'probe-wait' then
  local marker = io.open(arg[3], 'w')
  assert(marker:isopen(), 'probe fixture cannot create marker')
  marker:write(tostring(c_getpid()), '\n')
  marker:close()
  if arg[1] == 'probe-wait' then
    wait_for_file(arg[2])
    os.exit(0)
  end
  local gate = io.open(arg[2], 'r')
  if not gate:isopen() then os.exit(1) end
  gate:close()
  os.exit(0)
end

if arg[1] == 'orphan-burst' then
  local dir = arg[2]
  local intermediate = c_fork()
  assert(intermediate >= 0, 'orphan fixture fork failed')
  if intermediate == 0 then
    local list = io.open(dir .. '/pids', 'w')
    assert(list:isopen(), 'orphan fixture cannot create pid list')
    for _: integer = 1, 80 do
      local pid = c_fork()
      assert(pid >= 0, 'orphan fixture could not create descendant')
      if pid == 0 then
        for _: integer = 1, 600 do
          local gate = io.open(dir .. '/exit', 'r')
          if gate:isopen() then gate:close(); c_exit(17) end
          c_usleep(25000)
        end
        c_exit(18)
      end
      list:write(tostring(pid), '\n')
    end
    list:close()
    c_exit(0)
  end
  local status: cint
  assert(c_waitpid(intermediate, &status, 0) == intermediate and status == 0,
         'orphan fixture intermediate failed')
  local ready = io.open(dir .. '/adopted', 'w')
  assert(ready:isopen(), 'orphan fixture cannot publish readiness')
  ready:close()
  while true do c_pause() end
end

if arg[1] == 'log-churn' then
  for _: integer = 1, 24 do
    local helper = c_fork()
    assert(helper >= 0, 'log fixture fork failed')
    if helper == 0 then
      for _: integer = 1, 24 do
        local pid = c_fork()
        assert(pid >= 0, 'log fixture descendant fork failed')
        if pid == 0 then c_exit(19) end
      end
      c_exit(0)
    end
    local status: cint
    assert(c_waitpid(helper, &status, 0) == helper and status == 0, 'log fixture failed')
  end
  local ready = io.open(arg[2], 'w')
  assert(ready:isopen(), 'log fixture could not publish completion')
  ready:close()
  while true do c_pause() end
end

if arg[1] == 'tree' then
  local dir = arg[2]
  local first = io.open(dir .. '/first.pid', 'r')
  local restarting = first:isopen()
  if restarting then first:close() end
  local leader = c_getpid()
  local descendant = c_fork()
  assert(descendant >= 0, 'tree fixture fork failed')
  if descendant == 0 then
    assert(c_setsid() >= 0, 'tree fixture setsid failed')
    assert(c_signal(SIGTERM, SIG_IGN) ~= SIG_ERR, 'tree fixture cannot ignore SIGTERM')
    local marker = dir .. '/first.pid'
    if restarting then marker = dir .. '/second.pid' end
    local file = io.open(marker, 'w')
    assert(file:isopen(), 'tree fixture cannot create marker')
    file:write(tostring(leader), ' ', tostring(c_getpid()), '\n')
    file:close()
    while true do c_pause() end
  end
  if not restarting then
    wait_for_file(dir .. '/exit')
    os.exit(42)
  end
  while true do c_pause() end
end

if arg[1] == 'delay-term' then
  local mask: StopSigset
  assert(c_sigemptyset(&mask) == 0 and c_sigaddset(&mask, SIGTERM) == 0 and
         c_sigprocmask(SIG_BLOCK, &mask, nilptr) == 0, 'failed to block SIGTERM')
  local marker = io.open(arg[2] .. '.ready', 'w')
  assert(marker:isopen(), 'failed to publish readiness')
  marker:close()
  local signo: cint
  assert(c_sigwait(&mask, &signo) == 0 and signo == SIGTERM, 'failed to receive SIGTERM')
  c_usleep(1500000)
  local done = io.open(arg[2] .. '.stopped', 'w')
  assert(done:isopen(), 'failed to publish completion')
  done:close()
  os.exit(0)
end

if arg[1] == 'ignore-term' then
  assert(c_signal(SIGTERM, SIG_IGN) ~= SIG_ERR, 'failed to ignore SIGTERM')
  local marker = io.open(arg[2], 'w')
  assert(marker:isopen(), 'failed to create readiness marker')
  marker:close()
  while true do c_pause() end
end

if arg[1] == 'listen' then
  local path = arg[2]
  if #arg >= 3 then wait_for_file(arg[3]) end
  local address = endpoint(path)
  local fd = c_socket(AF_UNIX, SOCK_STREAM, 0)
  assert(fd >= 0, 'readiness fixture socket failed')
  assert(c_bind(fd, &address, (@cuint)(2 + #path + 1)) == 0, 'readiness fixture bind failed')
  assert(c_listen(fd, 4) == 0, 'readiness fixture listen failed')
  while true do
    local connection = c_accept(fd, nilptr, nilptr)
    assert(connection >= 0, 'readiness fixture accept failed')
    c_close(connection)
  end
end

if arg[1] == 'fill-backlog' then
  local path = os.getenv('THESEUS_SOCKET')
  local address = endpoint(path)
  for _ = 1, 64 do
    local fd = c_socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK, 0)
    assert(fd >= 0, 'backlog fixture socket failed')
    if c_connect(fd, &address, (@cuint)(2 + #path + 1)) ~= 0 then
      assert(errno == EAGAIN, 'backlog fixture connect failed')
      c_close(fd)
      local marker = io.open(arg[2], 'w')
      assert(marker:isopen(), 'backlog fixture cannot publish readiness')
      marker:close()
      while true do c_pause() end
    end
  end
  assert(false, 'control socket backlog did not fill')
end

if arg[1] == 'hold-requests' then
  for _ = 1, 8 do
    local fd = connect()
    send(fd, 'TQ1\tSTAT')
  end
  local ready = io.open(arg[2], 'w')
  assert(ready:isopen())
  ready:close()
  while true do c_pause() end
end

local request = 'TQ1\tSTATUS\tsleep-stop\n'
local fragmented = connect()
send(fragmented, 'TQ1\tSTAT')

local disconnected = connect()
assert(c_shutdown(disconnected, SHUT_RD) == 0, 'shutdown read side failed')
send(disconnected, request)
c_close(disconnected)

local healthy = connect()
send(healthy, request)
expect_status(healthy)
c_close(healthy)

send(fragmented, 'US\tsleep-stop\n')
expect_status(fragmented)
c_close(fragmented)

local idle = connect()
local event: Pollfd = {fd = idle, events = POLLIN}
assert(c_poll(&event, 1, 3000) == 1, 'idle connection never expired')
local byte: cchar
assert(c_read(idle, &byte, 1) == 0, 'idle connection received unexpected data')
c_close(idle)
