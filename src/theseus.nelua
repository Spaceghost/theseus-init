-- Theseus userspace supervisor bootstrap.
-- Maintained implementation is Nelua. CUE emits TSC2 records consumed here.

require 'arg'
require 'io'
require 'os'
require 'string'

-- Linux/POSIX boundary. These are declarations in maintained Nelua, not
-- hand-maintained C helpers. Child-side work after fork is deliberately only
-- execvp/_exit: all allocation and argv construction happens before fork.
local function c_fork(): cint <cimport 'fork', nodecl, cinclude '<unistd.h>'> end
local function c_execvp(file: cstring, argv: *cstring): cint <cimport 'execvp', nodecl, cinclude '<unistd.h>'> end
local function c__exit(status: cint): void <cimport '_exit', nodecl, cinclude '<unistd.h>'> end
local function c_waitpid(pid: cint, status: *cint, options: cint): cint <cimport 'waitpid', nodecl, cinclude '<sys/wait.h>'> end
local function c_close(fd: cint): cint <cimport 'close', nodecl, cinclude '<unistd.h>'> end
local function c_kill(pid: cint, signal: cint): cint <cimport 'kill', nodecl, cinclude '<signal.h>'> end
local function c_usleep(usec: cuint): cint <cimport 'usleep', nodecl, cinclude '<unistd.h>'> end
local function c_syscall2(number: clong, a1: clong, a2: clong): clong <cimport 'syscall', nodecl, cinclude '<unistd.h>'> end
local function c_syscall4(number: clong, a1: clong, a2: clong, a3: pointer, a4: clong): clong <cimport 'syscall', nodecl, cinclude '<unistd.h>'> end
local SYS_pidfd_open: clong <cimport, nodecl, cinclude '<sys/syscall.h>'>
local SYS_pidfd_send_signal: clong <cimport, nodecl, cinclude '<sys/syscall.h>'>
local SIGTERM: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGKILL: cint <cimport, nodecl, cinclude '<signal.h>'>

local ServiceState = @enum{
  Absent = 0,
  Planned,
  Starting,
  Ready,
  Running,
  Degraded,
  Stopping,
  Stopped,
  Failed,
  Backoff,
}

local RestartPolicy = @enum{
  Never = 0,
  OnFailure,
  Always,
}

local ReadinessKind = @enum{
  None = 0,
  Pid,
  UnixSocket,
}

local QueryKind = @enum{
  Invalid = 0,
  SystemStatus,
  ServiceStatus,
  ServiceState,
  ServiceRestartPolicy,
  Services,
  FailedServices,
  RunningServices,
  RunService,
}

local Service = @record{
  name: string,
  argv_serialized: string,
  state: ServiceState,
  restart: RestartPolicy,
  max_restarts: integer,
  readiness: ReadinessKind,
}

local Query = @record{
  kind: QueryKind,
  subject: string,
  stop_after_ms: integer,
}

local ExecArgv = @record{
  storage: [32]string,
  cargs: [33]cstring,
  count: integer,
}

local ExitResult = @record{
  waited: boolean,
  exit_code: integer,
  signal: integer,
}

local function state_name(state: ServiceState): string
  if state == ServiceState.Absent then return 'ABSENT' end
  if state == ServiceState.Planned then return 'PLANNED' end
  if state == ServiceState.Starting then return 'STARTING' end
  if state == ServiceState.Ready then return 'READY' end
  if state == ServiceState.Running then return 'RUNNING' end
  if state == ServiceState.Degraded then return 'DEGRADED' end
  if state == ServiceState.Stopping then return 'STOPPING' end
  if state == ServiceState.Stopped then return 'STOPPED' end
  if state == ServiceState.Failed then return 'FAILED' end
  if state == ServiceState.Backoff then return 'BACKOFF' end
  return 'UNKNOWN'
end

local function restart_name(policy: RestartPolicy): string
  if policy == RestartPolicy.Never then return 'never' end
  if policy == RestartPolicy.OnFailure then return 'on-failure' end
  if policy == RestartPolicy.Always then return 'always' end
  return 'invalid'
end

local function readiness_name(kind: ReadinessKind): string
  if kind == ReadinessKind.None then return 'none' end
  if kind == ReadinessKind.Pid then return 'pid' end
  if kind == ReadinessKind.UnixSocket then return 'unix-socket' end
  return 'invalid'
end

local function parse_restart(value: string): (boolean, RestartPolicy)
  if value == 'never' then return true, RestartPolicy.Never end
  if value == 'on-failure' then return true, RestartPolicy.OnFailure end
  if value == 'always' then return true, RestartPolicy.Always end
  return false, RestartPolicy.Never
end

local function parse_readiness(value: string): (boolean, ReadinessKind)
  if value == 'none' then return true, ReadinessKind.None end
  if value == 'pid' then return true, ReadinessKind.Pid end
  if value == 'unix-socket' then return true, ReadinessKind.UnixSocket end
  return false, ReadinessKind.None
end

local function can_transition(from: ServiceState, to: ServiceState): boolean
  if from == ServiceState.Absent then return to == ServiceState.Planned end
  if from == ServiceState.Planned then
    return to == ServiceState.Starting or to == ServiceState.Stopped
  end
  if from == ServiceState.Starting then
    return to == ServiceState.Ready or to == ServiceState.Running or
           to == ServiceState.Failed or to == ServiceState.Stopping
  end
  if from == ServiceState.Ready then
    return to == ServiceState.Running or to == ServiceState.Degraded or
           to == ServiceState.Stopping or to == ServiceState.Failed
  end
  if from == ServiceState.Running then
    return to == ServiceState.Degraded or to == ServiceState.Stopping or
           to == ServiceState.Stopped or to == ServiceState.Failed
  end
  if from == ServiceState.Degraded then
    return to == ServiceState.Running or to == ServiceState.Stopping or
           to == ServiceState.Failed
  end
  if from == ServiceState.Stopping then
    return to == ServiceState.Stopped or to == ServiceState.Failed
  end
  if from == ServiceState.Stopped then
    return to == ServiceState.Starting or to == ServiceState.Planned
  end
  if from == ServiceState.Failed then
    return to == ServiceState.Backoff or to == ServiceState.Starting or
           to == ServiceState.Stopped
  end
  if from == ServiceState.Backoff then
    return to == ServiceState.Starting or to == ServiceState.Stopped
  end
  return false
end

local function transition(service: *Service, to: ServiceState): boolean
  if not can_transition(service.state, to) then
    io.stderr:write('theseus: illegal transition ', service.name, ' ',
      state_name(service.state), ' -> ', state_name(to), '\n')
    return false
  end
  print('transition', service.name, state_name(service.state), state_name(to))
  service.state = to
  return true
end

-- Return one 1-indexed tab-delimited field and the next cursor. A next cursor
-- of zero means this was the final field.
local function next_field(line: string, cursor: isize): (string, isize)
  local first, last = string.find(line, '\t', cursor, true)
  if first == 0 then
    return string.sub(line, cursor), 0
  end
  return string.sub(line, cursor, first - 1), last + 1
end

local function parse_bounded_decimal(text: string, maximum: integer): (boolean, integer)
  if #text == 0 then return false, 0 end
  local value: integer = 0
  for i: isize = 1, #text do
    local byte = string.byte(text, i)
    if byte < 48 or byte > 57 then return false, 0 end
    value = value * 10 + (byte - 48)
    if value > maximum then return false, 0 end
  end
  return true, value
end

local function parse_service_record(line: string): (boolean, Service)
  local service: Service
  local cursor: isize = 1
  local magic: string
  magic, cursor = next_field(line, cursor)
  if magic ~= 'TSC2' or cursor == 0 then return false, service end

  service.name, cursor = next_field(line, cursor)
  if #service.name == 0 or cursor == 0 then return false, service end

  service.argv_serialized, cursor = next_field(line, cursor)
  if #service.argv_serialized == 0 or cursor == 0 then return false, service end

  local restart: string
  restart, cursor = next_field(line, cursor)
  if cursor == 0 then return false, service end
  local restart_ok: boolean
  restart_ok, service.restart = parse_restart(restart)
  if not restart_ok then return false, service end

  local maximum_text: string
  maximum_text, cursor = next_field(line, cursor)
  if cursor == 0 then return false, service end
  local maximum_ok: boolean
  maximum_ok, service.max_restarts = parse_bounded_decimal(maximum_text, 1000000)
  if not maximum_ok then return false, service end

  local readiness: string
  readiness, cursor = next_field(line, cursor)
  if cursor ~= 0 then return false, service end
  local readiness_ok: boolean
  readiness_ok, service.readiness = parse_readiness(readiness)
  if not readiness_ok then return false, service end

  service.state = ServiceState.Planned
  return true, service
end

local function decode_exec_argv(serialized: string, out: *ExecArgv): boolean
  local cursor: isize = 1
  local count: integer = 0
  while cursor ~= 0 do
    if count >= 32 then return false end
    local first, last = string.find(serialized, '\31', cursor, true)
    local item: string
    if first == 0 then
      item = string.sub(serialized, cursor)
      cursor = 0
    else
      item = string.sub(serialized, cursor, first - 1)
      cursor = last + 1
    end
    if #item == 0 then return false end
    out.storage[count] = item
    out.cargs[count] = (@cstring)(out.storage[count])
    count = count + 1
  end
  if count == 0 then return false end
  out.cargs[count] = nilptr
  out.count = count
  return true
end

local function records_path(): string
  local configured = os.getenv('THESEUS_RECORDS')
  if #configured > 0 then return configured end
  return './build/services.tsc'
end

local function load_service(path: string, wanted: string): (boolean, Service)
  local file = io.open(path, 'r')
  if not file:isopen() then
    local empty: Service
    return false, empty
  end
  for line in file:lines() do
    local ok: boolean
    local service: Service
    ok, service = parse_service_record(line)
    if ok and service.name == wanted then
      file:close()
      return true, service
    end
  end
  file:close()
  local empty: Service
  return false, empty
end

local function print_services(path: string, filter: QueryKind)
  local file = io.open(path, 'r')
  if not file:isopen() then
    io.stderr:write('theseus: cannot open compiled service records: ', path, '\n')
    os.exit(2)
  end
  local count: integer = 0
  for line in file:lines() do
    local ok: boolean
    local service: Service
    ok, service = parse_service_record(line)
    if ok then
      local selected = filter == QueryKind.Services or
        (filter == QueryKind.FailedServices and service.state == ServiceState.Failed) or
        (filter == QueryKind.RunningServices and service.state == ServiceState.Running)
      if selected then
        print(service.name, state_name(service.state))
        count = count + 1
      end
    end
  end
  file:close()
  if count == 0 and filter ~= QueryKind.Services then
    print('(none)')
  end
end

local function pidfd_open_for(pid: cint): cint
  return (@cint)(c_syscall2(SYS_pidfd_open, (@clong)(pid), 0))
end

local function pidfd_send_signal(fd: cint, signal: cint): boolean
  return c_syscall4(SYS_pidfd_send_signal, (@clong)(fd), (@clong)(signal), nilptr, 0) == 0
end

local function wait_for_child(pid: cint): ExitResult
  local result: ExitResult
  local status: cint = 0
  local waited = c_waitpid(pid, &status, 0)
  if waited ~= pid then return result end
  result.waited = true
  local term = status & 0x7f
  if term == 0 then
    result.exit_code = (status >> 8) & 0xff
    return result
  end
  if term ~= 0x7f then
    result.exit_code = -1
    result.signal = term
    return result
  end
  result.waited = false
  return result
end

local function restart_needed(policy: RestartPolicy, result: ExitResult): boolean
  if policy == RestartPolicy.Always then return true end
  if policy == RestartPolicy.OnFailure then
    return result.signal ~= 0 or result.exit_code ~= 0
  end
  return false
end

local function cleanup_unidentified_child(pid: cint)
  -- pidfd acquisition failed. The child is ours and has not been reaped, so
  -- its PID cannot have been recycled. PID-based SIGKILL is cleanup only.
  c_kill(pid, SIGKILL)
  local ignored = wait_for_child(pid)
  if not ignored.waited then
    io.stderr:write('theseus: failed to reap child after pidfd acquisition failure\n')
  end
end

local function supervise_service(service: Service, stop_after_ms: integer): integer
  local execargv: ExecArgv
  if not decode_exec_argv(service.argv_serialized, &execargv) then
    io.stderr:write('theseus: malformed argv record for ', service.name, '\n')
    return 65
  end
  if service.readiness == ReadinessKind.UnixSocket then
    io.stderr:write('theseus: unix-socket readiness is not implemented yet for ',
      service.name, '; refusing to spawn it\n')
    return 69
  end
  if stop_after_ms < 0 or stop_after_ms > 60000 then
    io.stderr:write('theseus: stop-after-ms must be between 0 and 60000\n')
    return 64
  end

  local attempts: integer = 0
  local restarts: integer = 0
  while true do
    if not transition(&service, ServiceState.Starting) then return 70 end
    attempts = attempts + 1

    local pid = c_fork()
    if pid == 0 then
      c_execvp(execargv.cargs[0], &execargv.cargs[0])
      c__exit(127)
    end
    if pid < 0 then
      transition(&service, ServiceState.Failed)
      io.stderr:write('theseus: fork failed for ', service.name, '\n')
      return 71
    end

    local pidfd = pidfd_open_for(pid)
    if pidfd < 0 then
      cleanup_unidentified_child(pid)
      transition(&service, ServiceState.Failed)
      io.stderr:write('theseus: pidfd_open failed for ', service.name,
        '; refusing PID-only supervision\n')
      return 72
    end
    print('spawn', service.name, 'pid', pid, 'pidfd', pidfd, 'attempt', attempts)

    if service.readiness == ReadinessKind.Pid then
      if not transition(&service, ServiceState.Ready) then
        c_close(pidfd)
        cleanup_unidentified_child(pid)
        return 70
      end
      if not transition(&service, ServiceState.Running) then
        c_close(pidfd)
        cleanup_unidentified_child(pid)
        return 70
      end
    else
      if not transition(&service, ServiceState.Running) then
        c_close(pidfd)
        cleanup_unidentified_child(pid)
        return 70
      end
    end

    local intentional_stop = stop_after_ms > 0
    if intentional_stop then
      c_usleep((@cuint)(stop_after_ms * 1000))
      if not transition(&service, ServiceState.Stopping) then
        c_close(pidfd)
        cleanup_unidentified_child(pid)
        return 70
      end
      if not pidfd_send_signal(pidfd, SIGTERM) then
        -- Cleanup must not strand a child if the pidfd operation failed.
        c_kill(pid, SIGKILL)
        local cleaned = wait_for_child(pid)
        c_close(pidfd)
        if cleaned.waited then transition(&service, ServiceState.Failed) end
        io.stderr:write('theseus: pidfd_send_signal failed for ', service.name, '\n')
        return 73
      end
      print('signal', service.name, 'pidfd', pidfd, 'signal', SIGTERM)
    end

    local result = wait_for_child(pid)
    c_close(pidfd)
    if not result.waited then
      if service.state ~= ServiceState.Failed then transition(&service, ServiceState.Failed) end
      io.stderr:write('theseus: waitpid failed for ', service.name, '\n')
      return 74
    end

    if intentional_stop then
      if not transition(&service, ServiceState.Stopped) then return 70 end
      print('result', service.name, 'STOPPED', 'attempts', attempts,
        'restarts', restarts, 'exit', result.exit_code, 'signal', result.signal)
      return 0
    end

    local succeeded = result.signal == 0 and result.exit_code == 0
    if succeeded then
      if not transition(&service, ServiceState.Stopped) then return 70 end
    else
      if not transition(&service, ServiceState.Failed) then return 70 end
    end
    print('exit', service.name, 'code', result.exit_code, 'signal', result.signal)

    local wants_restart = restart_needed(service.restart, result)
    if wants_restart and restarts < service.max_restarts then
      restarts = restarts + 1
      if service.state == ServiceState.Failed then
        if not transition(&service, ServiceState.Backoff) then return 70 end
      end
      local delay_ms = restarts * 10
      if delay_ms > 1000 then delay_ms = 1000 end
      c_usleep((@cuint)(delay_ms * 1000))
      print('restart', service.name, 'count', restarts, 'delay-ms', delay_ms)
      -- STOPPED may restart directly; BACKOFF transitions to STARTING.
    else
      if succeeded then
        print('result', service.name, 'STOPPED', 'attempts', attempts,
          'restarts', restarts, 'exit', result.exit_code, 'signal', result.signal)
        return 0
      end
      print('result', service.name, 'FAILED', 'attempts', attempts,
        'restarts', restarts, 'exit', result.exit_code, 'signal', result.signal)
      return 1
    end
  end
end

local function parse_the_query(): Query
  local query: Query
  if #arg == 1 and arg[1] == 'status' then
    query.kind = QueryKind.SystemStatus
    return query
  end
  if #arg == 1 and arg[1] == 'services' then
    query.kind = QueryKind.Services
    return query
  end
  if #arg == 2 and arg[2] == 'services' then
    if arg[1] == 'failed' then query.kind = QueryKind.FailedServices; return query end
    if arg[1] == 'running' then query.kind = QueryKind.RunningServices; return query end
  end
  if #arg == 3 and arg[2] == 'of' then
    query.subject = arg[3]
    if arg[1] == 'status' then query.kind = QueryKind.ServiceStatus; return query end
    if arg[1] == 'state' then query.kind = QueryKind.ServiceState; return query end
    if arg[1] == 'restart-policy' then query.kind = QueryKind.ServiceRestartPolicy; return query end
  end
  query.kind = QueryKind.Invalid
  return query
end

local function parse_theseus_query(): Query
  local query: Query
  if #arg == 1 and arg[1] == 'status' then
    query.kind = QueryKind.SystemStatus
    return query
  end
  if #arg == 1 and arg[1] == 'services' then
    query.kind = QueryKind.Services
    return query
  end
  if #arg == 2 then
    query.subject = arg[2]
    if arg[1] == 'status' then query.kind = QueryKind.ServiceStatus; return query end
    if arg[1] == 'state' then query.kind = QueryKind.ServiceState; return query end
    if arg[1] == 'run' then query.kind = QueryKind.RunService; return query end
  end
  if #arg == 4 and arg[1] == 'run' and arg[3] == '--stop-after-ms' then
    query.subject = arg[2]
    local ok: boolean
    ok, query.stop_after_ms = parse_bounded_decimal(arg[4], 60000)
    if ok and query.stop_after_ms > 0 then
      query.kind = QueryKind.RunService
      return query
    end
  end
  query.kind = QueryKind.Invalid
  return query
end

local function query_mode_is_the(): boolean
  if #arg[0] < 3 then return false end
  return string.sub(arg[0], -3) == 'the'
end

local function show_service(service: Service)
  print(service.name)
  print('  state       ', state_name(service.state))
  print('  restart     ', restart_name(service.restart))
  print('  max-restarts', service.max_restarts)
  print('  readiness   ', readiness_name(service.readiness))
  print('  argv-record ', service.argv_serialized)
  print('  source       CUE -> TSC2')
end

local function execute_query(query: Query)
  local path = records_path()
  if query.kind == QueryKind.SystemStatus then
    print('Theseus userspace supervisor')
    print('  pid1         no')
    print('  supervisor   process-lifecycle')
    print('  identity     pidfd-required')
    print('  records      ', path)
    print('  language     Nelua')
    print('  config       CUE')
    return
  end
  if query.kind == QueryKind.Services or query.kind == QueryKind.FailedServices or
     query.kind == QueryKind.RunningServices then
    print_services(path, query.kind)
    return
  end
  if query.kind == QueryKind.ServiceStatus or query.kind == QueryKind.ServiceState or
     query.kind == QueryKind.ServiceRestartPolicy or query.kind == QueryKind.RunService then
    local found: boolean
    local service: Service
    found, service = load_service(path, query.subject)
    if not found then
      io.stderr:write('theseus: unknown service: ', query.subject, '\n')
      os.exit(3)
    end
    if query.kind == QueryKind.ServiceStatus then
      show_service(service)
    elseif query.kind == QueryKind.ServiceState then
      print(state_name(service.state))
    elseif query.kind == QueryKind.ServiceRestartPolicy then
      print(restart_name(service.restart))
    else
      os.exit(supervise_service(service, query.stop_after_ms))
    end
    return
  end
  io.stderr:write('theseus: invalid query\n')
  if query_mode_is_the() then
    io.stderr:write('usage: the status [of SERVICE] | the state of SERVICE | the services | the failed services\n')
  else
    io.stderr:write('usage: theseus status [SERVICE] | theseus state SERVICE | theseus services | theseus run SERVICE [--stop-after-ms N]\n')
  end
  os.exit(64)
end

local function selftest()
  assert(can_transition(ServiceState.Absent, ServiceState.Planned))
  assert(can_transition(ServiceState.Planned, ServiceState.Starting))
  assert(can_transition(ServiceState.Starting, ServiceState.Ready))
  assert(can_transition(ServiceState.Ready, ServiceState.Running))
  assert(can_transition(ServiceState.Running, ServiceState.Failed))
  assert(can_transition(ServiceState.Running, ServiceState.Stopped))
  assert(can_transition(ServiceState.Failed, ServiceState.Backoff))
  assert(can_transition(ServiceState.Backoff, ServiceState.Starting))
  assert(not can_transition(ServiceState.Absent, ServiceState.Running))
  assert(not can_transition(ServiceState.Running, ServiceState.Planned))

  local ok: boolean
  local service: Service
  ok, service = parse_service_record('TSC2\tpostgresql\t/usr/bin/postgres\31-D\31/var/lib/postgresql\ton-failure\t5\tunix-socket')
  assert(ok)
  assert(service.name == 'postgresql')
  assert(service.state == ServiceState.Planned)
  assert(service.restart == RestartPolicy.OnFailure)
  assert(service.max_restarts == 5)
  assert(service.readiness == ReadinessKind.UnixSocket)

  local execargv: ExecArgv
  assert(decode_exec_argv(service.argv_serialized, &execargv))
  assert(execargv.count == 3)
  assert(execargv.storage[0] == '/usr/bin/postgres')
  assert(execargv.storage[1] == '-D')
  assert(execargv.storage[2] == '/var/lib/postgresql')

  ok, service = parse_service_record('TSC1\tbad\t/bin/false\tnever\t0\tnone')
  assert(not ok)
  ok, service = parse_service_record('TSC2\tbad\t/bin/false\tmaybe\t0\tnone')
  assert(not ok)
  ok, service = parse_service_record('TSC2\tbad\t/bin/false\tnever\t-1\tnone')
  assert(not ok)
  ok, service = parse_service_record('TSC2\tbad\t/bin/false\tnever\t0\tmagic')
  assert(not ok)

  print('Theseus core self-test passed')
end

if #arg == 1 and arg[1] == '--selftest' then
  selftest()
  os.exit(0)
end

local query = query_mode_is_the() and parse_the_query() or parse_theseus_query()
execute_query(query)
