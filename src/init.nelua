## cflags '-D_GNU_SOURCE'

-- Explicitly selected Linux PID 1 entry point. The service supervisor is a child.
require 'arg'
require 'io'
require 'os'
require 'string'
require 'src.theseus.recovery'
require 'src.theseus.install_paths'

local Sigset: type <cimport 'sigset_t', nodecl, cinclude '<signal.h>'> = @record{}
local Statfs: type <cimport 'struct statfs', nodecl, cinclude '<sys/statfs.h>'> = @record{f_type: clong}
local Timespec: type <cimport 'struct timespec', nodecl, cinclude '<time.h>'> = @record{tv_sec: clong, tv_nsec: clong}
local Pollfd = @record{fd: cint, events: cshort, revents: cshort}
local SignalHandler = @function(cint): void
local function c_getpid(): cint <cimport 'getpid', nodecl, cinclude '<unistd.h>'> end
local function c_fork(): cint <cimport 'fork', nodecl, cinclude '<unistd.h>'> end
local function c_execv(path: cstring, argv: *cstring): cint <cimport 'execv', nodecl, cinclude '<unistd.h>'> end
local function c_exit(status: cint): void <cimport '_exit', nodecl, cinclude '<unistd.h>'> end
local function c_open(path: cstring, flags: cint): cint <cimport 'open', nodecl, cinclude '<fcntl.h>'> end
local function c_close(fd: cint): cint <cimport 'close', nodecl, cinclude '<unistd.h>'> end
local function c_readlink(path: cstring, data: pointer, size: csize): clong <cimport 'readlink', nodecl, cinclude '<unistd.h>'> end
local function c_read(fd: cint, data: pointer, count: csize): clong <cimport 'read', nodecl, cinclude '<unistd.h>'> end
local function c_write(fd: cint, data: pointer, count: csize): clong <cimport 'write', nodecl, cinclude '<unistd.h>'> end
local function c_pipe2(fds: *cint, flags: cint): cint <cimport 'pipe2', nodecl, cinclude '<unistd.h>'> end
local function c_fcntl(fd: cint, command: cint, value: cint): cint <cimport 'fcntl', nodecl, cinclude '<fcntl.h>'> end
local function c_dup2(source: cint, dest: cint): cint <cimport 'dup2', nodecl, cinclude '<unistd.h>'> end
local function c_setpgid(pid: cint, group: cint): cint <cimport 'setpgid', nodecl, cinclude '<unistd.h>'> end
local function c_setsid(): cint <cimport 'setsid', nodecl, cinclude '<unistd.h>'> end
local function c_ioctl(fd: cint, command: culong, value: cint): cint <cimport 'ioctl', nodecl, cinclude '<sys/ioctl.h>'> end
local function c_statfs(path: cstring, data: *Statfs): cint <cimport 'statfs', nodecl, cinclude '<sys/statfs.h>'> end
local function c_mount(source: cstring, target: cstring, kind: cstring, flags: culong, data: pointer): cint <cimport 'mount', nodecl, cinclude '<sys/mount.h>'> end
local function c_mkdir(path: cstring, mode: cuint): cint <cimport 'mkdir', nodecl, cinclude '<sys/stat.h>'> end
local function c_access(path: cstring, mode: cint): cint <cimport 'access', nodecl, cinclude '<unistd.h>'> end
local function c_setenv(name: cstring, value: cstring, replace: cint): cint <cimport 'setenv', nodecl, cinclude '<stdlib.h>'> end
local function c_unsetenv(name: cstring): cint <cimport 'unsetenv', nodecl, cinclude '<stdlib.h>'> end
local function c_kill(pid: cint, signal: cint): cint <cimport 'kill', nodecl, cinclude '<signal.h>'> end
local function c_waitpid(pid: cint, status: *cint, flags: cint): cint <cimport 'waitpid', nodecl, cinclude '<sys/wait.h>'> end
local function c_signal(sig: cint, action: SignalHandler): SignalHandler <cimport 'signal', nodecl, cinclude '<signal.h>'> end
local function c_sigemptyset(set: *Sigset): cint <cimport 'sigemptyset', nodecl, cinclude '<signal.h>'> end
local function c_sigaddset(set: *Sigset, sig: cint): cint <cimport 'sigaddset', nodecl, cinclude '<signal.h>'> end
local function c_sigprocmask(how: cint, set: *Sigset, previous: *Sigset): cint <cimport 'sigprocmask', nodecl, cinclude '<signal.h>'> end
local function c_signalfd(fd: cint, set: *Sigset, flags: cint): cint <cimport 'signalfd', nodecl, cinclude '<sys/signalfd.h>'> end
local function c_poll(fds: *Pollfd, count: culong, timeout: cint): cint <cimport 'poll', nodecl, cinclude '<poll.h>'> end
local function c_clock_gettime(clock: cint, now: *Timespec): cint <cimport 'clock_gettime', nodecl, cinclude '<time.h>'> end
local function c_sync(): void <cimport 'sync', nodecl, cinclude '<unistd.h>'> end
local function c_reboot(command: cint): cint <cimport 'reboot', nodecl, cinclude '<sys/reboot.h>'> end

local F_SETFL: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local F_SETFD: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local O_CLOEXEC: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local O_NONBLOCK: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local O_NOCTTY: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local O_WRONLY: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local O_RDWR: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local TIOCSCTTY: culong <cimport, nodecl, cinclude '<sys/ioctl.h>'>
local MS_NOSUID: culong <cimport, nodecl, cinclude '<sys/mount.h>'>
local MS_NODEV: culong <cimport, nodecl, cinclude '<sys/mount.h>'>
local MS_NOEXEC: culong <cimport, nodecl, cinclude '<sys/mount.h>'>
local MS_REMOUNT: culong <cimport, nodecl, cinclude '<sys/mount.h>'>
local MS_RDONLY: culong <cimport, nodecl, cinclude '<sys/mount.h>'>
local PROC_SUPER_MAGIC: clong <cimport, nodecl, cinclude '<linux/magic.h>'>
local SYSFS_MAGIC: clong <cimport, nodecl, cinclude '<linux/magic.h>'>
local TMPFS_MAGIC: clong <cimport, nodecl, cinclude '<linux/magic.h>'>
local CGROUP2_SUPER_MAGIC: clong <cimport, nodecl, cinclude '<linux/magic.h>'>
local SIGCHLD: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGTERM: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGINT: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGUSR1: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGUSR2: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGKILL: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIG_DFL: SignalHandler <cimport, nodecl, cinclude '<signal.h>'>
local SIG_ERR: SignalHandler <cimport, nodecl, cinclude '<signal.h>'>
local SIG_SETMASK: cint <cimport, nodecl, cinclude '<signal.h>'>
local SFD_CLOEXEC: cint <cimport, nodecl, cinclude '<sys/signalfd.h>'>
local SFD_NONBLOCK: cint <cimport, nodecl, cinclude '<sys/signalfd.h>'>
local POLLOUT: cshort <cimport, nodecl, cinclude '<poll.h>'>
local POLLIN: cshort <cimport, nodecl, cinclude '<poll.h>'>
local WNOHANG: cint <cimport, nodecl, cinclude '<sys/wait.h>'>
local EAGAIN: cint <cimport, nodecl, cinclude '<errno.h>'>
local EINTR: cint <cimport, nodecl, cinclude '<errno.h>'>
local ECHILD: cint <cimport, nodecl, cinclude '<errno.h>'>
local EEXIST: cint <cimport, nodecl, cinclude '<errno.h>'>
local errno: cint <cimport, nodecl, cinclude '<errno.h>'>
local CLOCK_MONOTONIC: cint <cimport, nodecl, cinclude '<time.h>'>
local RB_DISABLE_CAD: cint <cimport, nodecl, cinclude '<sys/reboot.h>'>
local RB_HALT_SYSTEM: cint <cimport, nodecl, cinclude '<sys/reboot.h>'>
local RB_AUTOBOOT: cint <cimport, nodecl, cinclude '<sys/reboot.h>'>
local RB_POWER_OFF: cint <cimport, nodecl, cinclude '<sys/reboot.h>'>

local Console: cstring = '/dev/console'
local Delegation = '/sys/fs/cgroup/theseus-init'
local worker_path = '/sbin/theseusd'
local graph_path = '/etc/theseus/graph.tsc'
local OpenRC: cstring = '/sbin/openrc'
local Rescue: cstring = '/bin/sh'
-- 32 services each get up to four seconds for probe, leader, and cgroup cleanup.
local WorkerGrace <comptime> = 135000
local OpenRCGrace <comptime> = 120000

local Action = @enum{None = 0, Poweroff, Reboot, Halt}
local Session = @record{
  worker: cint,
  rescue: cint,
  rescue_at: integer,
  openrc: cint,
  openrc_failed: boolean,
  openrc_started: boolean,
}
local console: cint = -1

local function report(event: string)
  if console < 0 then return end
  local line = 'TI1\t' .. event .. '\n'
  local written = c_write(console, line.data, #line)
  if written == #line or (written < 0 and errno ~= EAGAIN and errno ~= EINTR) then return end
  -- Retry a transiently busy console without letting it hold up PID 1.
  local output: Pollfd = {fd = console, events = POLLOUT}
  if c_poll(&output, 1, 10) <= 0 or (output.revents & POLLOUT) == 0 then return end
  local offset: usize = 0
  if written > 0 then offset = (@usize)(written) end
  c_write(console, &line.data[offset], #line - offset)
end

local function now_ms(): integer
  local now: Timespec
  c_clock_gettime(CLOCK_MONOTONIC, &now)
  return (@integer)(now.tv_sec) * 1000 + now.tv_nsec // 1000000
end

local function directory(path: cstring, mode: cuint): boolean
  return c_mkdir(path, mode) == 0 or errno == EEXIST
end

local function has_type(path: cstring, magic: clong): boolean
  local info: Statfs <noinit>
  return c_statfs(path, &info) == 0 and info.f_type == magic
end

local function mount_type(kind: cstring, path: cstring, flags: culong, magic: clong): boolean
  return has_type(path, magic) or c_mount(kind, path, kind, flags, nilptr) == 0
end

local function command_line(): (boolean, boolean, boolean, boolean, boolean)
  local file = io.open('/proc/cmdline', 'r')
  if not file:isopen() then return false, false, false, true, false end
  local line = file:read('*a')
  file:close()
  local enabled, rescue, openrc, rescue_disabled, trial: boolean, boolean, boolean, boolean, boolean
  for option in string.gmatch(line, '%S+') do
    if option == 'theseus.pid1=1' then enabled = true end
    if option == 'theseus.rescue=1' then rescue = true end
    if option == 'theseus.rescue=off' then rescue_disabled = true end
    if option == 'theseus.openrc=1' then openrc = true end
    if option == 'theseus.trial=1' then trial = true end
  end
  return enabled, rescue, openrc, rescue_disabled, trial and enabled and not rescue
end

local function provision_run(): boolean
  return directory('/run', 0x1ed) and mount_type('tmpfs', '/run', MS_NOSUID | MS_NODEV, TMPFS_MAGIC)
end

local function provision(openrc: boolean): boolean
  local flags = MS_NOSUID | MS_NODEV | MS_NOEXEC
  if not mount_type('sysfs', '/sys', flags, SYSFS_MAGIC) then return false end
  if openrc then
    -- OpenRC owns the hierarchy. Mounting over it could hide its service groups.
    if not has_type('/sys/fs/cgroup', CGROUP2_SUPER_MAGIC) then return false end
  elseif not mount_type('cgroup2', '/sys/fs/cgroup', flags, CGROUP2_SUPER_MAGIC) then
    return false
  end
  return directory((@cstring)(TheseusRuntimeDir), 0x1c0) and directory((@cstring)(Delegation), 0x1c0)
end

local function signal_queue(): cint
  local set: Sigset
  if c_sigemptyset(&set) ~= 0 or
     c_sigaddset(&set, SIGCHLD) ~= 0 or c_sigaddset(&set, SIGTERM) ~= 0 or
     c_sigaddset(&set, SIGINT) ~= 0 or c_sigaddset(&set, SIGUSR1) ~= 0 or
     c_sigaddset(&set, SIGUSR2) ~= 0 or c_sigprocmask(SIG_SETMASK, &set, nilptr) ~= 0 then return -1 end
  if c_signal(SIGCHLD, SIG_DFL) == SIG_ERR or c_signal(SIGINT, SIG_DFL) == SIG_ERR or
     c_signal(SIGTERM, SIG_DFL) == SIG_ERR or c_signal(SIGUSR1, SIG_DFL) == SIG_ERR or
     c_signal(SIGUSR2, SIG_DFL) == SIG_ERR then return -1 end
  return c_signalfd(-1, &set, SFD_CLOEXEC | SFD_NONBLOCK)
end

-- OpenRC shutdown scripts can write normally even when the console is stuck.
-- Drain at most one chunk per poll so noisy scripts cannot starve signals.
local function relay_shutdown_output(fd: cint): boolean
  local data: [4096]byte <noinit>
  local size = c_read(fd, &data[0], #data)
  if size <= 0 then return false end
  if console >= 0 then c_write(console, &data[0], (@csize)(size)) end
  return true
end

local function notification(fd: cint, timeout: cint, output: cint): (boolean, Action)
  local events: [2]Pollfd = {{fd = fd, events = POLLIN}, {fd = output, events = POLLIN}}
  local ready = c_poll(&events[0], 2, timeout)
  if ready <= 0 then return ready == 0 or errno == EINTR, Action.None end
  if (events[1].revents & POLLIN) ~= 0 then relay_shutdown_output(output) end
  if events[0].revents == 0 then return true, Action.None end
  -- The Linux signalfd record is 128 bytes and starts with a native uint32.
  local info: [32]uint32 <noinit>
  local size = #info * #uint32
  if c_read(fd, &info[0], size) ~= size then return false, Action.None end
  if info[0] == (@cuint)(SIGUSR1) then return true, Action.Halt end
  if info[0] == (@cuint)(SIGUSR2) then return true, Action.Poweroff end
  if info[0] == (@cuint)(SIGTERM) or info[0] == (@cuint)(SIGINT) then return true, Action.Reboot end
  return true, Action.None
end

local function select_bundle(): boolean
  local path: [4096]byte <noinit>
  local size = c_readlink('/proc/self/exe', &path[0], #path)
  if size <= 0 or size == #path then return false end
  local executable: string = {data = &path[0], size = (@usize)(size)}
  local prefix = TheseusReleaseRoot .. '/'
  local selected = arg[0]
  if string.sub(selected, 1, #prefix) == prefix and selected ~= executable then return false end
  if string.sub(executable, 1, #prefix) ~= prefix then return true end
  local matched, fields = string.match(string.sub(executable, #prefix + 1), '^([^/]+)/theseus%-init$')
  if not matched or not valid_theseus_release_id(fields[1]) then return false end
  local bundle = prefix .. fields[1]
  worker_path = bundle .. '/theseusd'
  graph_path = bundle .. '/graph.tsc'
  report('release\t' .. fields[1])
  return true
end

local function unblock_signals()
  local unblocked: Sigset
  if c_sigemptyset(&unblocked) ~= 0 or c_sigprocmask(SIG_SETMASK, &unblocked, nilptr) ~= 0 then c_exit(126) end
end

local function launch(rescue: boolean): cint
  local pid = c_fork()
  if pid ~= 0 then return pid end
  unblock_signals()
  if rescue then
    c_setsid()
    local fd = c_open(Console, O_RDWR | O_NOCTTY)
    if fd < 0 then c_exit(126) end
    c_ioctl(fd, TIOCSCTTY, 0)
    for side = 0, 2 do
      if c_dup2(fd, (@cint)(side)) < 0 then c_exit(126) end
    end
    if fd > 2 then c_close(fd) end
    local argv: [3]cstring = {Rescue, '-i', nilptr}
    c_execv(Rescue, &argv[0])
  else
    if c_setenv('THESEUS_GRAPH', (@cstring)(graph_path), 1) ~= 0 or
       c_setenv('THESEUS_CGROUP_ROOT', (@cstring)(Delegation), 1) ~= 0 or
       c_setenv('THESEUS_RECOVERY_DIR', (@cstring)(TheseusRuntimeDir), 1) ~= 0 or
       c_setenv('THESEUS_SOCKET', (@cstring)(TheseusControlSocket), 1) ~= 0 then c_exit(126) end
    local worker = (@cstring)(worker_path)
    local argv: [4]cstring = {worker, '--target', 'default', nilptr}
    c_execv(worker, &argv[0])
  end
  c_exit(127)
  return -1
end

local function reclaim(): boolean
  local root = cgroup_open_root(Delegation)
  if root < 0 then return false end
  defer c_close(root) end
  local instance: RecoverableInstance = {dir = -1, scope = -1}
  defer recovery_close(&instance) end
  return recovery_reclaim(&instance, TheseusControlSocket, TheseusRuntimeDir, root) == 0
end

-- Return whether any child may remain. Batching avoids starving the signal queue.
local function reap(session: *Session): boolean
  local status: cint
  for _ = 1, 64 do
    local pid = c_waitpid(-1, &status, WNOHANG)
    if pid <= 0 then return pid == 0 or errno ~= ECHILD end
    if pid == session.worker then
      session.worker = 0
      report('supervisor-exit\t' .. tostring((status >> 8) & 0xff) .. '\t' .. tostring(status & 0x7f))
    elseif pid == session.rescue then
      session.rescue = 0
      session.rescue_at = now_ms() + 1000
      report('rescue-exit')
    elseif pid == session.openrc then
      session.openrc = 0
      session.openrc_failed = status ~= 0
      report('openrc-exit\t' .. tostring((status >> 8) & 0xff) .. '\t' .. tostring(status & 0x7f))
    else
      report('adopted-exit\t' .. tostring(pid) .. '\t' .. tostring((status >> 8) & 0xff) .. '\t' .. tostring(status & 0x7f))
    end
  end
  return true
end

local function await_cleanup(fd: cint, session: *Session, worker_only: boolean, grace: integer): boolean
  local deadline = now_ms() + grace
  while true do
    local remaining = reap(session)
    if (worker_only and session.worker == 0) or not remaining then return true end
    local left = deadline - now_ms()
    if left <= 0 then return false end
    local timeout = 50
    if left < timeout then timeout = left end
    notification(fd, (@cint)(timeout), -1)
  end
  return false
end

local function launch_openrc(argument: cstring, output: cint): cint
  local pid = c_fork()
  if pid > 0 then
    c_setpgid(pid, pid)
  elseif pid == 0 then
    if c_setpgid(0, 0) ~= 0 then c_exit(126) end
    unblock_signals()
    if c_unsetenv('RC_REBOOT') ~= 0 then c_exit(126) end
    -- A pipe endpoint may already occupy an inherited standard descriptor.
    if output >= 0 and (c_dup2(output, 1) < 0 or c_dup2(output, 2) < 0 or
       c_fcntl(1, F_SETFD, 0) < 0 or c_fcntl(2, F_SETFD, 0) < 0) then c_exit(126) end
    local argv: [3]cstring = {OpenRC, argument, nilptr}
    c_execv(OpenRC, &argv[0])
    c_exit(127)
  end
  return pid
end

-- Keep PID 1 responsive while the distribution's runlevel program runs.
local function openrc_phase(fd: cint, session: *Session, level: cstring, shutdown_action: Action): (boolean, Action)
  local shutting_down = shutdown_action ~= Action.None
  report('openrc-start\t' .. tostring(level))
  local output: [2]cint = {-1, -1}
  if shutting_down then
    if c_pipe2(&output[0], O_CLOEXEC | O_NONBLOCK) ~= 0 then
      report('openrc-output-pipe-failed')
    elseif c_fcntl(output[1], F_SETFL, 0) ~= 0 then
      c_close(output[0])
      c_close(output[1])
      output = {-1, -1}
      report('openrc-output-pipe-failed')
    end
  end
  -- Keep the parent writer open while polling so EOF cannot wake it repeatedly.
  defer
    if output[0] >= 0 then
      c_close(output[1])
      for _ = 1, 16 do
        if not relay_shutdown_output(output[0]) then break end
      end
      c_close(output[0])
    end
  end
  -- OpenRC maps reboot onto shutdown and sets RC_REBOOT for its scripts.
  local argument: cstring = level
  if shutdown_action == Action.Reboot then argument = 'reboot' end
  session.openrc = launch_openrc(argument, output[1])
  if session.openrc <= 0 then return false, Action.None end
  local deadline = now_ms() + OpenRCGrace
  local action = Action.None
  local interrupted = false
  while session.openrc > 0 do
    local ok, received = notification(fd, 100, output[0])
    -- A cancelled leader may already be waitable while its group remains
    -- alive. Keep its PID reserved until the final signal to the group.
    if not interrupted then reap(session) end
    if not shutting_down and action == Action.None and received ~= Action.None then action = received end
    if session.openrc <= 0 then break end
    local now = now_ms()
    if not interrupted and (now >= deadline or action ~= Action.None or not ok) then
      if now >= deadline then report('openrc-timeout\t' .. tostring(level)) end
      if c_kill(-session.openrc, SIGTERM) ~= 0 then c_kill(session.openrc, SIGTERM) end
      interrupted = true
      deadline = now + 2000
    elseif interrupted and now >= deadline then
      if c_kill(-session.openrc, SIGKILL) ~= 0 then c_kill(session.openrc, SIGKILL) end
      -- Poll one final bounded interval for the phase leader to exit.
      for _ = 1, 10 do
        notification(fd, 100, -1)
        reap(session)
        if session.openrc <= 0 then break end
      end
      break
    end
  end
  return session.openrc == 0 and not session.openrc_failed and not interrupted, action
end

local function boot_openrc(fd: cint, session: *Session): (boolean, Action)
  session.openrc_started = true
  local levels: [3]cstring = {'sysinit', 'boot', 'default'}
  for i = 0, 2 do
    local ok, action = openrc_phase(fd, session, levels[i], Action.None)
    if not ok or action ~= Action.None then return false, action end
  end
  return true, Action.None
end

local function shutdown(fd: cint, session: *Session, action: Action, had_worker: boolean)
  local cmd = RB_POWER_OFF
  if action == Action.Reboot then
    cmd = RB_AUTOBOOT
    report('shutdown\treboot')
  elseif action == Action.Halt then
    cmd = RB_HALT_SYSTEM
    report('shutdown\thalt')
  else
    report('shutdown\tpoweroff')
  end
  if session.worker > 0 then
    c_kill(session.worker, SIGTERM)
    if not await_cleanup(fd, session, true, WorkerGrace) then
      report('supervisor-timeout')
      c_kill(session.worker, SIGKILL)
      await_cleanup(fd, session, true, 1000)
    end
  end
  if had_worker and not reclaim() then report('supervisor-reclaim-failed') end
  -- Keep compatibility services available until native clients have stopped.
  if session.openrc_started then
    if session.openrc > 0 then report('openrc-phase-still-running')
    elseif not openrc_phase(fd, session, 'shutdown', action) then report('openrc-shutdown-failed') end
    session.openrc_started = false
  end
  -- Sweep children and session processes outside the managed cgroups last.
  c_kill(-1, SIGTERM)
  if not await_cleanup(fd, session, false, 2000) then
    c_kill(-1, SIGKILL)
    if not await_cleanup(fd, session, false, 1000) then report('remaining-processes') end
  end
  c_sync()
  if c_mount(nilptr, '/', nilptr, MS_REMOUNT | MS_RDONLY, nilptr) ~= 0 then report('root-remount-failed') end
  report('shutdown-ready')
  c_reboot(cmd)
  report('reboot-syscall-failed\t' .. tostring(errno))
end

local function run()
  directory('/dev', 0x1ed)
  directory('/proc', 0x1ed)
  directory('/sys', 0x1ed)
  if c_access(Console, 0) ~= 0 then c_mount('devtmpfs', '/dev', 'devtmpfs', MS_NOSUID, nilptr) end
  console = c_open(Console, O_WRONLY | O_NONBLOCK | O_CLOEXEC | O_NOCTTY)
  local boot, preferred_rescue, openrc, rescue_disabled, trial = false, false, false, true, false
  if mount_type('proc', '/proc', MS_NOSUID | MS_NODEV | MS_NOEXEC, PROC_SUPER_MAGIC) then
    boot, preferred_rescue, openrc, rescue_disabled, trial = command_line()
  end
  if rescue_disabled then report('rescue-console\tdisabled') end
  c_setenv('PATH', '/usr/sbin:/usr/bin:/sbin:/bin', 1)
  local fd = signal_queue()
  if fd >= 0 and c_reboot(RB_DISABLE_CAD) ~= 0 then report('ctrl-alt-del-config-failed') end
  local session: Session
  local reason: string
  local pending = Action.None
  if fd < 0 then
    reason = 'signal-queue'
  elseif not boot then
    reason = 'missing-opt-in'
  elseif preferred_rescue then
    reason = 'requested'
  elseif not select_bundle() then
    reason = 'release-path'
  elseif not provision_run() then
    reason = 'boot-filesystems'
  else
    if openrc then
      local ok: boolean
      ok, pending = boot_openrc(fd, &session)
      if not ok then reason = 'openrc-boot' end
    end
    if #reason == 0 then
      if not provision(openrc) then
        reason = 'boot-filesystems'
      else
        session.worker = launch(false)
        if session.worker <= 0 then reason = 'supervisor-fork' end
      end
    end
  end
  local had_worker = session.worker > 0
  local in_rescue = not had_worker
  if had_worker then report('supervisor-start\t' .. tostring(session.worker))
  else report('rescue\t' .. reason) end
  while true do
    local timeout: cint = 100
    if fd < 0 then timeout = 1000 end
    local ok, action = true, pending
    if pending == Action.None then ok, action = notification(fd, timeout, -1) end
    pending = Action.None
    reap(&session)
    if action == Action.None and not in_rescue and session.worker == 0 then
      if not trial and not reclaim() then report('supervisor-reclaim-failed') end
      in_rescue = true
      reason = 'supervisor'
      report('rescue\t' .. reason)
    end
    if action == Action.None and trial and in_rescue then
      report('trial-reboot\t' .. reason)
      action = Action.Reboot
    end
    if action ~= Action.None then
      -- If reboot returns, stay in rescue instead of retrying the action.
      trial = false
      shutdown(fd, &session, action, had_worker)
      in_rescue = true
      report('rescue\tshutdown-failed')
    elseif fd < 0 or not ok then
      if fd >= 0 then c_close(fd) end
      fd = signal_queue()
      if fd < 0 then report('signal-queue-failed') end
    end
    if in_rescue and not rescue_disabled and session.rescue <= 0 and now_ms() >= session.rescue_at then
      session.rescue = launch(true)
      if session.rescue < 0 then session.rescue_at = now_ms() + 1000 end
    end
  end
end

if c_getpid() ~= 1 then
  io.stderr:write('theseus-init requires Linux PID 1\n')
  os.exit(64)
end
run()
