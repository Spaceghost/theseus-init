-- Theseus live local client. Compile once and invoke as `theseus` or `the`.
-- `the` has no mutating grammar.

require 'arg'
require 'io'
require 'os'
require 'string'
require 'src.theseus.openrc'

local function c_socket(domain: cint, kind: cint, protocol: cint): cint <cimport 'socket', nodecl, cinclude '<sys/socket.h>'> end
local function c_connect(fd: cint, address: pointer, length: cuint): cint <cimport 'connect', nodecl, cinclude '<sys/socket.h>'> end
local function c_read(fd: cint, buffer: pointer, count: csize): clong <cimport 'read', nodecl, cinclude '<unistd.h>'> end
local function c_send(fd: cint, buffer: pointer, count: csize, flags: cint): clong <cimport 'send', nodecl, cinclude '<sys/socket.h>'> end
local function c_close(fd: cint): cint <cimport 'close', nodecl, cinclude '<unistd.h>'> end
local Timespec: type <cimport 'struct timespec', nodecl, cinclude '<time.h>'> = @record{tv_sec: clong, tv_nsec: clong}
local function c_clock_gettime(clock: cint, value: *Timespec): cint <cimport 'clock_gettime', nodecl, cinclude '<time.h>'> end
local Pollfd = @record{fd: cint, events: cshort, revents: cshort}
local function c_poll(fds: *Pollfd, count: culong, timeout: cint): cint <cimport 'poll', nodecl, cinclude '<poll.h>'> end
local CLOCK_MONOTONIC: cint <cimport, nodecl, cinclude '<time.h>'>
local POLLIN: cshort <cimport, nodecl, cinclude '<poll.h>'>
local POLLOUT: cshort <cimport, nodecl, cinclude '<poll.h>'>
local errno: cint <cimport, nodecl, cinclude '<errno.h>'>
local EINTR: cint <cimport, nodecl, cinclude '<errno.h>'>
local EAGAIN: cint <cimport, nodecl, cinclude '<errno.h>'>
local SOCK_NONBLOCK: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local MSG_NOSIGNAL: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local AF_UNIX: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_STREAM: cint <cimport, nodecl, cinclude '<sys/socket.h>'>

local QueryTimeout <comptime> = 5000
-- Allow the daemon to drain every service in a full target.
local ShutdownTimeout <comptime> = 140000

local SockaddrUn = @record{
  sun_family: cushort,
  sun_path: [108]cchar,
}

local function is_the(): boolean
  if #arg[0] < 3 then return false end
  return string.sub(arg[0], -3) == 'the'
end

local function socket_path(): string
  local path = os.getenv('THESEUS_SOCKET')
  if #path == 0 then
    io.stderr:write('theseus: THESEUS_SOCKET is required in userspace mode\n')
    os.exit(64)
  end
  if #path > 100 or string.byte(path, 1) ~= 47 then
    io.stderr:write('theseus: invalid socket path\n')
    os.exit(64)
  end
  return path
end

local function fill_address(address: *SockaddrUn, path: string)
  address.sun_family = (@cushort)(AF_UNIX)
  for i: integer = 0, 107 do address.sun_path[i] = 0 end
  for i: isize = 1, #path do
    address.sun_path[i - 1] = (@cchar)(string.byte(path, i))
  end
end

local function monotonic_ms(): integer
  local now: Timespec
  assert(c_clock_gettime(CLOCK_MONOTONIC, &now) == 0)
  return (@integer)(now.tv_sec) * 1000 + now.tv_nsec // 1000000
end

local function wait_socket(fd: cint, events: cshort, deadline: integer): boolean
  local event: Pollfd = {fd = fd, events = events}
  while true do
    local remaining = deadline - monotonic_ms()
    if remaining <= 0 then return false end
    local ready = c_poll(&event, 1, (@cint)(remaining))
    if ready > 0 then return (event.revents & events) ~= 0 end
    if ready == 0 or errno ~= EINTR then return false end
  end
end

local function write_all(fd: cint, text: string, deadline: integer): boolean
  local remaining = text
  while #remaining > 0 do
    if not wait_socket(fd, POLLOUT, deadline) then return false end
    local wrote = c_send(fd, (@cstring)(remaining), (@csize)(#remaining), MSG_NOSIGNAL)
    if wrote < 0 and (errno == EINTR or errno == EAGAIN) then continue end
    if wrote <= 0 then return false end
    if wrote == #remaining then return true end
    remaining = string.sub(remaining, wrote + 1)
  end
  return true
end

local function read_line(fd: cint, deadline: integer): (boolean, string)
  -- A snapshot can carry all 32 services with 63-byte names.
  local buffer: [4096]cchar
  local used: integer = 0
  while used < #buffer do
    if not wait_socket(fd, POLLIN, deadline) then return false, '' end
    local got = c_read(fd, &buffer[used], (@csize)(#buffer - used))
    if got < 0 and (errno == EINTR or errno == EAGAIN) then continue end
    if got <= 0 then return false, '' end
    local end_at = used + got
    for i: integer = used, end_at - 1 do
      if buffer[i] == 10 then
        local length: usize = (@usize)(i + 1)
        return true, string.copy((@string){data=&buffer[0], size=length})
      end
    end
    used = end_at
  end
  return false, ''
end

local function exchange_failed(deadline: integer): (boolean, string)
  if monotonic_ms() >= deadline then
    io.stderr:write('theseus: supervisor request timed out\n')
  else
    io.stderr:write('theseus: supervisor socket unavailable\n')
  end
  return false, ''
end

local function exchange(request: string, timeout: integer): (boolean, string)
  local path = socket_path()
  local deadline = monotonic_ms() + timeout
  local fd = c_socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK, 0)
  if fd < 0 then return exchange_failed(deadline) end
  defer c_close(fd) end
  local address: SockaddrUn
  fill_address(&address, path)
  if c_connect(fd, &address, (@cuint)(2 + #path + 1)) ~= 0 or
     not write_all(fd, request, deadline) then return exchange_failed(deadline) end
  local ok, response = read_line(fd, deadline)
  if not ok then return exchange_failed(deadline) end
  return true, response
end

local function next_field(line: string, cursor: isize): (string, isize)
  local first, last = string.find(line, '\t', cursor, true)
  if first == 0 then
    local final = string.sub(line, cursor)
    if #final > 0 and string.byte(final, #final) == 10 then final = string.sub(final, 1, #final - 1) end
    return final, 0
  end
  return string.sub(line, cursor, first - 1), last + 1
end

local function show_status(response: string, state_only: boolean): integer
  local cursor: isize = 1
  local magic: string
  local kind: string
  local name: string
  local state: string
  local pid: string
  local pidfd: string
  local restarts: string
  local last_exit: string
  local last_signal: string
  magic, cursor = next_field(response, cursor)
  kind, cursor = next_field(response, cursor)
  name, cursor = next_field(response, cursor)
  state, cursor = next_field(response, cursor)
  pid, cursor = next_field(response, cursor)
  pidfd, cursor = next_field(response, cursor)
  restarts, cursor = next_field(response, cursor)
  last_exit, cursor = next_field(response, cursor)
  last_signal, cursor = next_field(response, cursor)
  if magic ~= 'TR1' or kind ~= 'STATUS' or cursor ~= 0 or #name == 0 or #state == 0 then
    io.stderr:write('theseus: malformed supervisor response len=', tostring(#response),
      ' cursor=', tostring(cursor), ' magic=[', magic, '] kind=[', kind,
      '] name=[', name, '] state=[', state, '] pid=[', pid, '] pidfd=[', pidfd,
      '] restarts=[', restarts, '] last-exit=[', last_exit,
      '] last-signal=[', last_signal, '] raw=[', response, ']\n')
    return 65
  end
  if state_only then print(state); return 0 end
  print(name)
  print('  state      ', state)
  print('  pid        ', pid)
  print('  identity    pidfd')
  print('  pidfd      ', pidfd)
  print('  restarts   ', restarts)
  print('  last-exit  ', last_exit)
  print('  last-signal', last_signal)
  return 0
end

local function query_status(name: string, state_only: boolean): integer
  local ok: boolean
  local response: string
  ok, response = exchange('TQ1\tSTATUS\t' .. name .. '\n', QueryTimeout)
  if not ok then return 69 end
  return show_status(response, state_only)
end

local function print_services(response: string, filter: string): boolean
  local magic, kind, name, state: string
  local cursor: isize = 1
  magic, cursor = next_field(response, cursor)
  if magic ~= 'TR1' or cursor == 0 then return false end
  kind, cursor = next_field(response, cursor)
  if kind ~= 'SERVICES' then return false end
  while cursor ~= 0 do
    name, cursor = next_field(response, cursor)
    if #name == 0 or cursor == 0 then return false end
    state, cursor = next_field(response, cursor)
    if #state == 0 then return false end
    if #filter == 0 or filter == state then print(name, state) end
  end
  return true
end

local function query_services(filter: string): integer
  local ok, response = exchange('TQ1\tSERVICES\n', QueryTimeout)
  if not ok then return 69 end
  if not print_services(response, filter) then
    io.stderr:write('theseus: malformed services response\n')
    return 65
  end
  return 0
end

local function shutdown(): integer
  local ok: boolean
  local response: string
  ok, response = exchange('TQ1\tSHUTDOWN\n', ShutdownTimeout)
  if not ok then return 69 end
  if response ~= 'TR1\tOK\n' then
    io.stderr:write('theseus: supervisor rejected shutdown response=[', response, ']\n')
    return 70
  end
  print('Theseus supervisor stopped cleanly')
  return 0
end

dispatch_openrc(is_the())
if is_the() then
  if #arg == 1 and arg[1] == 'services' then os.exit(query_services('')) end
  if #arg == 2 and arg[2] == 'services' then
    if arg[1] == 'failed' then os.exit(query_services('FAILED')) end
    if arg[1] == 'running' then os.exit(query_services('RUNNING')) end
  end
  if #arg == 3 and arg[2] == 'of' and arg[1] == 'status' then
    os.exit(query_status(arg[3], false))
  end
  if #arg == 3 and arg[2] == 'of' and arg[1] == 'state' then
    os.exit(query_status(arg[3], true))
  end
  io.stderr:write('usage: the [failed | running] services | the status of SERVICE | the state of SERVICE | the status of openrc SERVICE | the openrc-runlevel\n')
  os.exit(64)
end

if #arg == 2 and arg[1] == 'status' then os.exit(query_status(arg[2], false)) end
if #arg == 2 and arg[1] == 'state' then os.exit(query_status(arg[2], true)) end
if #arg == 1 and arg[1] == 'services' then os.exit(query_services('')) end
if #arg == 1 and arg[1] == 'daemon-stop' then os.exit(shutdown()) end
io.stderr:write('usage: theseus services | theseus status SERVICE | theseus state SERVICE | theseus daemon-stop | theseus openrc SERVICE ACTION | theseus openrc-runlevel RUNLEVEL\n')
os.exit(64)
