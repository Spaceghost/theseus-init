## cflags '-D_GNU_SOURCE'

-- Long-lived Theseus userspace supervisor.
-- Maintained implementation is Nelua; CUE is compiled away before runtime.

require 'arg'
require 'io'
require 'math'
require 'os'
require 'string'
require 'stringbuilder'
require 'src.theseus.runtime_service'
require 'src.theseus.graph'
require 'src.theseus.cgroup'
require 'src.theseus.recovery'
require 'src.theseus.daemon_log'

local function c_fork(): cint <cimport 'fork', nodecl, cinclude '<unistd.h>'> end
local function c_execv(file: cstring, argv: *cstring): cint <cimport 'execv', nodecl, cinclude '<unistd.h>'> end
local function c_execvp(file: cstring, argv: *cstring): cint <cimport 'execvp', nodecl, cinclude '<unistd.h>'> end
local function c__exit(status: cint): void <cimport '_exit', nodecl, cinclude '<unistd.h>'> end
local function c_waitpid(pid: cint, status: *cint, options: cint): cint <cimport 'waitpid', nodecl, cinclude '<sys/wait.h>'> end
local ChildInfo: type <cimport 'siginfo_t', nodecl, cinclude '<signal.h>'> = @record{si_pid: cint}
local function c_waitid(kind: cint, id: cuint, info: *ChildInfo, options: cint): cint <cimport 'waitid', nodecl, cinclude '<sys/wait.h>'> end
local function c_prctl(option: cint, arg2: culong, arg3: culong, arg4: culong, arg5: culong): cint <cimport 'prctl', nodecl, cinclude '<sys/prctl.h>'> end
local function c_close(fd: cint): cint <cimport 'close', nodecl, cinclude '<unistd.h>'> end
local function c_kill(pid: cint, signal: cint): cint <cimport 'kill', nodecl, cinclude '<signal.h>'> end
local function c_syscall2(number: clong, a1: clong, a2: clong): clong <cimport 'syscall', nodecl, cinclude '<unistd.h>'> end
local function c_syscall4(number: clong, a1: clong, a2: clong, a3: pointer, a4: clong): clong <cimport 'syscall', nodecl, cinclude '<unistd.h>'> end
local function c_socket(domain: cint, kind: cint, protocol: cint): cint <cimport 'socket', nodecl, cinclude '<sys/socket.h>'> end
local function c_connect(fd: cint, address: pointer, length: cuint): cint <cimport 'connect', nodecl, cinclude '<sys/socket.h>'> end
local function c_socketpair(domain: cint, kind: cint, protocol: cint, fds: *cint): cint <cimport 'socketpair', nodecl, cinclude '<sys/socket.h>'> end
local function c_getsockopt(fd: cint, level: cint, option: cint, value: pointer, length: *cuint): cint <cimport 'getsockopt', nodecl, cinclude '<sys/socket.h>'> end
local function c_bind(fd: cint, address: pointer, length: cuint): cint <cimport 'bind', nodecl, cinclude '<sys/socket.h>'> end
local function c_listen(fd: cint, backlog: cint): cint <cimport 'listen', nodecl, cinclude '<sys/socket.h>'> end
local function c_accept4(fd: cint, address: pointer, length: pointer, flags: cint): cint <cimport 'accept4', nodecl, cinclude '<sys/socket.h>'> end
local function c_pipe2(fds: *cint, flags: cint): cint <cimport 'pipe2', nodecl, cinclude '<unistd.h>'> end
local function c_write(fd: cint, buffer: pointer, count: csize): clong <cimport 'write', nodecl, cinclude '<unistd.h>'> end
local function c_read(fd: cint, buffer: pointer, count: csize): clong <cimport 'read', nodecl, cinclude '<unistd.h>'> end
local function c_send(fd: cint, buffer: pointer, count: csize, flags: cint): clong <cimport 'send', nodecl, cinclude '<sys/socket.h>'> end
local function c_unlink(path: cstring): cint <cimport 'unlink', nodecl, cinclude '<unistd.h>'> end
local function c_access(path: cstring, mode: cint): cint <cimport 'access', nodecl, cinclude '<unistd.h>'> end
local function c_umask(mode: cuint): cuint <cimport 'umask', nodecl, cinclude '<sys/stat.h>'> end

local SignalHandler = @function(cint): void
local function c_signal(signal: cint, handler: SignalHandler): SignalHandler <cimport 'signal', nodecl, cinclude '<signal.h>'> end
local Sigset: type <cimport 'sigset_t', nodecl, cinclude '<signal.h>'> = @record{}
local Timespec: type <cimport 'struct timespec', nodecl, cinclude '<time.h>'> = @record{tv_sec: clong, tv_nsec: clong}
local function c_sigemptyset(set: *Sigset): cint <cimport 'sigemptyset', nodecl, cinclude '<signal.h>'> end
local function c_sigaddset(set: *Sigset, signal: cint): cint <cimport 'sigaddset', nodecl, cinclude '<signal.h>'> end
local function c_sigprocmask(how: cint, set: *Sigset, previous: *Sigset): cint <cimport 'sigprocmask', nodecl, cinclude '<signal.h>'> end
local function c_signalfd(fd: cint, set: *Sigset, flags: cint): cint <cimport 'signalfd', nodecl, cinclude '<sys/signalfd.h>'> end
local function c_clock_gettime(clock: cint, value: *Timespec): cint <cimport 'clock_gettime', nodecl, cinclude '<time.h>'> end

local Pollfd = @record{fd: cint, events: cshort, revents: cshort}
local function c_poll(fds: *Pollfd, count: culong, timeout_ms: cint): cint <cimport 'poll', nodecl, cinclude '<poll.h>'> end

local Credentials: type <cimport 'struct ucred', nodecl, cinclude '<sys/socket.h>'> = @record{
  pid: cint, uid: cuint, gid: cuint,
}
local SOL_SOCKET: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SO_PEERCRED: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
-- Linux's generic UAPI value also works with libc headers predating the option.
local PeerPidfdOption <comptime> = 77
local AF_UNIX: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_STREAM: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_CLOEXEC: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_NONBLOCK: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local MSG_NOSIGNAL: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SIG_BLOCK: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIG_SETMASK: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGCHLD: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIG_DFL: SignalHandler <cimport, nodecl, cinclude '<signal.h>'>
local SIG_ERR: SignalHandler <cimport, nodecl, cinclude '<signal.h>'>
local SIGINT: cint <cimport, nodecl, cinclude '<signal.h>'>
local PR_SET_CHILD_SUBREAPER: cint <cimport, nodecl, cinclude '<sys/prctl.h>'>
local P_ALL: cint <cimport, nodecl, cinclude '<sys/wait.h>'>
local WEXITED: cint <cimport, nodecl, cinclude '<sys/wait.h>'>
local WNOHANG: cint <cimport, nodecl, cinclude '<sys/wait.h>'>
local WNOWAIT: cint <cimport, nodecl, cinclude '<sys/wait.h>'>
local ECHILD: cint <cimport, nodecl, cinclude '<errno.h>'>
local SFD_NONBLOCK: cint <cimport, nodecl, cinclude '<sys/signalfd.h>'>
local SFD_CLOEXEC: cint <cimport, nodecl, cinclude '<sys/signalfd.h>'>
local CLOCK_MONOTONIC: cint <cimport, nodecl, cinclude '<time.h>'>
local errno: cint <cimport, nodecl, cinclude '<errno.h>'>
local EINTR: cint <cimport, nodecl, cinclude '<errno.h>'>
local EAGAIN: cint <cimport, nodecl, cinclude '<errno.h>'>
local EMFILE: cint <cimport, nodecl, cinclude '<errno.h>'>
local ENFILE: cint <cimport, nodecl, cinclude '<errno.h>'>
local ESRCH: cint <cimport, nodecl, cinclude '<errno.h>'>
local O_CLOEXEC: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local O_NONBLOCK: cint <cimport, nodecl, cinclude '<fcntl.h>'>
local POLLOUT: cshort <cimport, nodecl, cinclude '<poll.h>'>
local POLLIN: cshort <cimport, nodecl, cinclude '<poll.h>'>
local SYS_pidfd_open: clong <cimport, nodecl, cinclude '<sys/syscall.h>'>
local SYS_pidfd_send_signal: clong <cimport, nodecl, cinclude '<sys/syscall.h>'>
local SIGTERM: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGKILL: cint <cimport, nodecl, cinclude '<signal.h>'>

local SockaddrUn = @record{sun_family: cushort, sun_path: [108]cchar}
local ServiceState = @enum{Planned = 0, Starting, Ready, Running, Stopped, Failed, Backoff, Stopping}

local Runtime = @record{
  service: RuntimeService,
  status_request: string,
  state: ServiceState,
  pid: cint,
  pidfd: cint,
  execfd: cint,
  probe_args: ExecArgv,
  probe_pid: cint,
  probe_fd: cint,
  probe_by: integer,
  probe_cancelled: boolean,
  cgroup: ServiceCgroup,
  drain_by: integer,
  exit_state: ServiceState,
  attempts: integer,
  restarts: integer,
  action_at: integer,
  ready_by: integer,
  kill_sent: boolean,
  last_exit: integer,
  last_signal: integer,
}

local Supervision = @record{
  name: string,
  target: boolean,
  count: integer,
  next_start: integer,
  announced: boolean,
  runtimes: [NativeMaxServices]Runtime,
  arguments: [NativeMaxServices]ExecArgv,
  required: [NativeMaxServices]boolean,
  needs: [NativeMaxServices][NativeMaxServices]boolean,
}

local function state_name(state: ServiceState): string
  if state == ServiceState.Planned then return 'PLANNED' end
  if state == ServiceState.Starting then return 'STARTING' end
  if state == ServiceState.Ready then return 'READY' end
  if state == ServiceState.Running then return 'RUNNING' end
  if state == ServiceState.Stopped then return 'STOPPED' end
  if state == ServiceState.Failed then return 'FAILED' end
  if state == ServiceState.Backoff then return 'BACKOFF' end
  if state == ServiceState.Stopping then return 'STOPPING' end
  return 'UNKNOWN'
end

local function transition(runtime: *Runtime, state: ServiceState, reason: string)
  if runtime.state == state then return end
  daemon_log('TE1', 'state', runtime.service.name, runtime.attempts,
        state_name(runtime.state), state_name(state), reason)
  runtime.state = state
end

local function load_service(path: string, wanted: string): (boolean, RuntimeService)
  local file = io.open(path, 'r')
  if not file:isopen() then local empty: RuntimeService; return false, empty end
  for line in file:lines() do
    local ok: boolean
    local service: RuntimeService
    ok, service = parse_runtime_service(line)
    if ok and service.name == wanted then file:close(); return true, service end
  end
  file:close()
  local empty: RuntimeService
  return false, empty
end

local function pidfd_open_for(pid: cint): cint
  return (@cint)(c_syscall2(SYS_pidfd_open, (@clong)(pid), 0))
end

local function pidfd_send_signal(fd: cint, signal: cint): boolean
  return c_syscall4(SYS_pidfd_send_signal, (@clong)(fd), (@clong)(signal), nilptr, 0) == 0
end

local function decode_wait(status: cint, runtime: *Runtime)
  local term = status & 0x7f
  if term == 0 then
    runtime.last_exit = (status >> 8) & 0xff
    runtime.last_signal = 0
  else
    runtime.last_exit = -1
    runtime.last_signal = term
  end
end

local function monotonic_ms(): integer
  local now: Timespec
  c_clock_gettime(CLOCK_MONOTONIC, &now)
  return (@integer)(now.tv_sec) * 1000 + now.tv_nsec // 1000000
end

local function open_shutdown_fd(child_mask: *Sigset): cint
  -- A launcher can pass down SIG_IGN. Keep each child waitable until reaped.
  if c_signal(SIGCHLD, SIG_DFL) == SIG_ERR then return -1 end
  local mask: Sigset
  if c_sigemptyset(&mask) ~= 0 or c_sigaddset(&mask, SIGTERM) ~= 0 or
     c_sigaddset(&mask, SIGINT) ~= 0 or c_sigprocmask(SIG_BLOCK, &mask, child_mask) ~= 0 then
    return -1
  end
  return c_signalfd(-1, &mask, SFD_CLOEXEC)
end

local function open_reap_fd(): cint
  if c_prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) ~= 0 then return -1 end
  local mask: Sigset
  if c_sigemptyset(&mask) ~= 0 or c_sigaddset(&mask, SIGCHLD) ~= 0 or
     c_sigprocmask(SIG_BLOCK, &mask, nilptr) ~= 0 then return -1 end
  return c_signalfd(-1, &mask, SFD_CLOEXEC | SFD_NONBLOCK)
end

local function read_child_signal(fd: cint): boolean
  -- The Linux signalfd ABI uses a 128-byte notification record.
  local notification: [128]byte
  local got = c_read(fd, &notification[0], #notification)
  while got < 0 and errno == EINTR do got = c_read(fd, &notification[0], #notification) end
  return got == #notification or (got < 0 and errno == EAGAIN)
end

local function wait_for_child(pid: cint, status: *cint): boolean
  local waited = c_waitpid(pid, status, 0)
  while waited < 0 and errno == EINTR do
    waited = c_waitpid(pid, status, 0)
  end
  return waited == pid
end

local function spawn(runtime: *Runtime, argv: *ExecArgv, child_mask: *Sigset): boolean
  runtime.attempts = runtime.attempts + 1
  transition(runtime, ServiceState.Starting, 'start')
  local handshake: [2]cint
  if c_pipe2(&handshake[0], O_CLOEXEC | O_NONBLOCK) ~= 0 then
    transition(runtime, ServiceState.Failed, 'exec-pipe')
    return false
  end
  local pid = c_fork()
  if pid == 0 then
    c_close(handshake[0])
    local failed: cchar = 2
    if cgroup_enter(&runtime.cgroup) then
      failed = 1
      if c_sigprocmask(SIG_SETMASK, child_mask, nilptr) == 0 then
        c_execvp(argv.cargs[0], &argv.cargs[0])
      end
    end
    c_write(handshake[1], &failed, 1)
    c__exit(127)
  end
  c_close(handshake[1])
  if pid < 0 then
    c_close(handshake[0])
    transition(runtime, ServiceState.Failed, 'fork')
    return false
  end
  local pidfd = pidfd_open_for(pid)
  if pidfd < 0 then
    c_close(handshake[0])
    c_kill(pid, SIGKILL)
    local status: cint = 0
    wait_for_child(pid, &status)
    transition(runtime, ServiceState.Failed, 'pidfd')
    return false
  end
  runtime.pid = pid
  runtime.pidfd = pidfd
  runtime.execfd = handshake[0]
  local timeout = runtime.service.readiness_options.timeout
  if timeout == 0 then timeout = 30000 end
  runtime.ready_by = monotonic_ms() + timeout
  runtime.action_at = runtime.ready_by
  daemon_log('daemon-spawn', runtime.service.name, 'pid', pid, 'pidfd', pidfd, 'attempt', runtime.attempts)
  return true
end

local function close_execfd(runtime: *Runtime)
  if runtime.execfd >= 0 then
    c_close(runtime.execfd)
    runtime.execfd = -1
  end
end

local function record_exec(runtime: *Runtime): boolean
  local failed: cchar
  local got = c_read(runtime.execfd, &failed, 1)
  if got < 0 then return errno == EAGAIN or errno == EINTR end
  close_execfd(runtime)
  if runtime.state ~= ServiceState.Starting then return true end
  if got > 0 then
    if failed == 2 then
      daemon_log('TE1', 'ownership', runtime.service.name, runtime.attempts, 'placement-failed')
      return false
    end
    daemon_log('TE1', 'service', runtime.service.name, runtime.attempts, 'exec-failed')
  elseif runtime.service.readiness == ReadinessKind.UnixSocket then
    runtime.action_at = monotonic_ms()
  else
    if runtime.service.readiness == ReadinessKind.Pid then
      transition(runtime, ServiceState.Ready, 'pid-ready')
    end
    transition(runtime, ServiceState.Running, 'startup-complete')
    runtime.action_at = 0
  end
  return true
end

local function should_restart(runtime: *Runtime): boolean
  if runtime.service.restart == RestartPolicy.Always then return true end
  if runtime.service.restart == RestartPolicy.OnFailure then
    return runtime.state == ServiceState.Failed
  end
  return false
end

local function reap(runtime: *Runtime): boolean
  local status: cint = 0
  if not wait_for_child(runtime.pid, &status) then return false end
  close_execfd(runtime)
  c_close(runtime.pidfd)
  runtime.pidfd = -1
  runtime.pid = 0
  decode_wait(status, runtime)
  daemon_log('TE1', 'service', runtime.service.name, runtime.attempts, 'exited', runtime.last_exit, runtime.last_signal)
  return true
end

local function cancel_probe(runtime: *Runtime, now: integer): boolean
  if runtime.probe_fd < 0 or runtime.probe_cancelled then return true end
  if not pidfd_send_signal(runtime.probe_fd, SIGKILL) and errno ~= ESRCH then return false end
  runtime.probe_cancelled = true
  runtime.probe_by = now + 1000
  return true
end

local function finish_exit(runtime: *Runtime)
  transition(runtime, runtime.exit_state, 'child-exit')
  runtime.drain_by = 0
  runtime.action_at = 0
  if should_restart(runtime) and runtime.restarts < runtime.service.max_restarts then
    local delay = (runtime.restarts + 1) * 10
    if delay > 1000 then delay = 1000 end
    runtime.action_at = monotonic_ms() + delay
    transition(runtime, ServiceState.Backoff, 'retry')
  end
end

local function record_exit(runtime: *Runtime): boolean
  local premature = runtime.state == ServiceState.Starting or runtime.state == ServiceState.Stopping
  if not reap(runtime) then return false end
  if runtime.state == ServiceState.Starting then
    daemon_log('TE1', 'readiness', runtime.service.name, runtime.attempts, 'exited-before-ready')
  end
  daemon_log('daemon-exit', runtime.service.name, 'code', runtime.last_exit, 'signal', runtime.last_signal)
  local now = monotonic_ms()
  if not cancel_probe(runtime, now) then return false end
  runtime.exit_state = ServiceState.Stopped
  if premature or runtime.last_exit ~= 0 or runtime.last_signal ~= 0 then
    runtime.exit_state = ServiceState.Failed
  end

  local ownership = cgroup_state(&runtime.cgroup)
  if ownership == CgroupState.Empty and runtime.probe_fd < 0 then
    finish_exit(runtime)
    return true
  end
  if ownership == CgroupState.Error then return false end
  if ownership == CgroupState.Populated then
    if not cgroup_kill(&runtime.cgroup) then
      daemon_log_error('theseusd: cannot drain cgroup for ', runtime.service.name, '\n')
      return false
    end
    daemon_log('TE1', 'ownership', runtime.service.name, runtime.attempts, 'draining')
  end
  transition(runtime, ServiceState.Stopping, 'drain')
  runtime.drain_by = now + 1000
  runtime.action_at = now + 10
  return true
end

local function socket_path(): string
  local path = os.getenv('THESEUS_SOCKET')
  if #path == 0 then daemon_log_error('theseusd: THESEUS_SOCKET is required in userspace mode\n'); return '' end
  if #path > 100 or string.byte(path, 1) ~= 47 then
    daemon_log_error('theseusd: socket path must be absolute and <=100 bytes\n')
    return ''
  end
  return path
end

local function fill_address(address: *SockaddrUn, path: string)
  address.sun_family = (@cushort)(AF_UNIX)
  for i: integer = 0, 107 do address.sun_path[i] = 0 end
  for i: isize = 1, #path do address.sun_path[i - 1] = (@cchar)(string.byte(path, i)) end
end

local function peer_pidfd(socket: cint): cint
  local fd: cint = -1
  local size = (@cuint)(#cint)
  if c_getsockopt(socket, SOL_SOCKET, PeerPidfdOption, &fd, &size) ~= 0 then return -1 end
  return fd
end

local function peer_pidfd_available(): boolean
  local pair: [2]cint
  if c_socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, &pair[0]) ~= 0 then return false end
  local peer = peer_pidfd(pair[0])
  c_close(pair[0])
  c_close(pair[1])
  if peer < 0 then return false end
  c_close(peer)
  return true
end

local function has_ready_peer(runtime: *Runtime): boolean
  local probe = c_socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0)
  if probe < 0 then return false end
  local path = runtime.service.readiness_options.path
  local address: SockaddrUn
  fill_address(&address, path)
  local ready = false
  if c_connect(probe, &address, (@cuint)(2 + #path + 1)) == 0 then
    local credentials: Credentials
    local size = (@cuint)(#Credentials)
    if c_getsockopt(probe, SOL_SOCKET, SO_PEERCRED, &credentials, &size) == 0 and
       credentials.pid == runtime.pid then
      local peer = peer_pidfd(probe)
      if peer >= 0 then
        -- A dead listener's credentials can retain a recycled numeric PID.
        -- The peer must be alive while our own child still owns that PID.
        local event: Pollfd = {fd = peer, events = POLLIN}
        ready = c_poll(&event, 1, 0) == 0
        c_close(peer)
      end
    end
  end
  c_close(probe)
  return ready
end

local function signal_child(runtime: *Runtime, signal: cint): boolean
  return pidfd_send_signal(runtime.pidfd, signal) or errno == ESRCH
end

local function mark_ready(runtime: *Runtime)
  transition(runtime, ServiceState.Ready, 'readiness-passed')
  daemon_log('TE1', 'readiness', runtime.service.name, runtime.attempts, 'ready')
  transition(runtime, ServiceState.Running, 'startup-complete')
  runtime.action_at = 0
end

local function start_probe(runtime: *Runtime, child_mask: *Sigset, now: integer): boolean
  local pid = c_fork()
  if pid == 0 then
    if not cgroup_enter(&runtime.cgroup) or
       c_sigprocmask(SIG_SETMASK, child_mask, nilptr) ~= 0 then c__exit(126) end
    local argv = &runtime.probe_args.cargs[0]
    c_execv(runtime.probe_args.cargs[0], argv)
    c__exit(127)
  end
  if pid < 0 then return false end
  local fd = pidfd_open_for(pid)
  if fd < 0 then
    c_kill(pid, SIGKILL)
    local status: cint
    wait_for_child(pid, &status)
    return false
  end
  runtime.probe_pid = pid
  runtime.probe_fd = fd
  runtime.probe_cancelled = false
  runtime.probe_by = now + runtime.service.readiness_options.probe_timeout
  runtime.action_at = math.min(runtime.probe_by, runtime.ready_by)
  return true
end

local function reap_probe(runtime: *Runtime, status: *cint): boolean
  if not wait_for_child(runtime.probe_pid, status) then return false end
  c_close(runtime.probe_fd)
  runtime.probe_fd = -1
  runtime.probe_pid = 0
  return true
end

local function record_probe(runtime: *Runtime): boolean
  local status: cint
  if not reap_probe(runtime, &status) then return false end
  if runtime.state ~= ServiceState.Starting then return true end
  local now = monotonic_ms()
  if not runtime.probe_cancelled and status == 0 and now < runtime.probe_by and now < runtime.ready_by and
     has_ready_peer(runtime) then
    mark_ready(runtime)
  else
    if not runtime.probe_cancelled then
      if now >= runtime.probe_by then
        daemon_log('TE1', 'readiness', runtime.service.name, runtime.attempts, 'probe-timeout')
      elseif status ~= 0 then
        daemon_log('TE1', 'readiness', runtime.service.name, runtime.attempts, 'probe-failed',
              (status >> 8) & 0xff, status & 0x7f)
      elseif now < runtime.ready_by then
        daemon_log('TE1', 'readiness', runtime.service.name, runtime.attempts, 'probe-peer-lost')
      end
    end
    runtime.action_at = math.min(now + runtime.service.readiness_options.interval, runtime.ready_by)
  end
  return true
end

local function advance_service(runtime: *Runtime, argv: *ExecArgv, child_mask: *Sigset): boolean
  local now = monotonic_ms()
  if runtime.action_at == 0 or now < runtime.action_at then return true end
  if runtime.drain_by ~= 0 then
    local ownership = cgroup_state(&runtime.cgroup)
    if ownership == CgroupState.Empty and runtime.probe_fd < 0 then
      if #runtime.cgroup.name > 0 then
        daemon_log('TE1', 'ownership', runtime.service.name, runtime.attempts, 'drained')
      end
      finish_exit(runtime)
      return true
    end
    if ownership == CgroupState.Error or now >= runtime.drain_by then
      daemon_log_error('theseusd: cgroup did not drain for ', runtime.service.name, '\n')
      return false
    end
    runtime.action_at = math.min(now + 10, runtime.drain_by)
    return true
  end
  if runtime.state == ServiceState.Backoff then
    runtime.action_at = 0
    runtime.restarts = runtime.restarts + 1
    return spawn(runtime, argv, child_mask)
  end
  if runtime.state == ServiceState.Starting then
    if now >= runtime.ready_by then
      if not cancel_probe(runtime, now) then return false end
      daemon_log('TE1', 'readiness', runtime.service.name, runtime.attempts, 'timeout')
      transition(runtime, ServiceState.Stopping, 'readiness-timeout')
      runtime.kill_sent = false
      runtime.action_at = now + 1000
      return signal_child(runtime, SIGTERM)
    end
    if runtime.probe_fd >= 0 then
      if now >= runtime.probe_by then
        if runtime.probe_cancelled or not cancel_probe(runtime, now) then return false end
        daemon_log('TE1', 'readiness', runtime.service.name, runtime.attempts, 'probe-timeout')
      end
      runtime.action_at = math.min(runtime.probe_by, runtime.ready_by)
    elseif runtime.execfd < 0 and runtime.service.readiness == ReadinessKind.UnixSocket and has_ready_peer(runtime) then
      if runtime.probe_args.count > 0 then return start_probe(runtime, child_mask, now) end
      mark_ready(runtime)
    else
      runtime.action_at = math.min(now + 25, runtime.ready_by)
    end
    return true
  end
  -- The startup timed out. Keep serving control requests while the child stops.
  if runtime.state == ServiceState.Stopping and not runtime.kill_sent then
    runtime.kill_sent = true
    runtime.action_at = now + 1000
    return signal_child(runtime, SIGKILL)
  end
  daemon_log_error('theseusd: could not stop child after readiness timeout\n')
  return false
end

local function write_all(fd: cint, text: string): boolean
  local remaining = text
  while #remaining > 0 do
    local wrote = c_send(fd, (@cstring)(remaining), (@csize)(#remaining), MSG_NOSIGNAL)
    if wrote <= 0 then return false end
    if wrote == #remaining then return true end
    remaining = string.sub(remaining, wrote + 1)
  end
  return true
end

local ControlClient = @record{
  buffer: [255]cchar,
  used: integer,
  deadline: integer,
}
local RequestState = @enum{Pending = 0, Complete, Closed, Invalid}
local ControlTimeout <comptime> = 1000
local MaxClients <comptime> = 8
local AcceptRetryMs <comptime> = 50

local function read_request(fd: cint, client: *ControlClient): (RequestState, string)
  local got = c_read(fd, &client.buffer[client.used], (@csize)(255 - client.used))
  if got < 0 and (errno == EAGAIN or errno == EINTR) then return RequestState.Pending, '' end
  if got <= 0 then return RequestState.Closed, '' end
  local end_at = client.used + got
  for i: integer = client.used, end_at - 1 do
    if client.buffer[i] == 10 then
      local length: usize = (@usize)(i + 1)
      return RequestState.Complete, (@string){data=&client.buffer[0], size=length}
    end
  end
  client.used = end_at
  if client.used == 255 then return RequestState.Invalid, '' end
  return RequestState.Pending, ''
end

local function write_status(fd: cint, runtime: *Runtime): boolean
  local pid = tostring(runtime.pid)
  local pidfd = tostring(runtime.pidfd)
  local restarts = tostring(runtime.restarts)
  local last_exit = tostring(runtime.last_exit)
  local last_signal = tostring(runtime.last_signal)
  return write_all(fd, 'TR1\tSTATUS\t') and
    write_all(fd, runtime.service.name) and write_all(fd, '\t') and
    write_all(fd, state_name(runtime.state)) and write_all(fd, '\t') and
    write_all(fd, pid) and write_all(fd, '\t') and
    write_all(fd, pidfd) and write_all(fd, '\t') and
    write_all(fd, restarts) and write_all(fd, '\t') and
    write_all(fd, last_exit) and write_all(fd, '\t') and
    write_all(fd, last_signal) and write_all(fd, '\n')
end

local function wait_for_exit(fd: cint, timeout: integer): cint
  local event: Pollfd = {fd = fd, events = POLLIN}
  local deadline = monotonic_ms() + timeout
  local ready = c_poll(&event, 1, (@cint)(timeout))
  while ready < 0 and errno == EINTR do
    local remaining = deadline - monotonic_ms()
    if remaining <= 0 then return 0 end
    ready = c_poll(&event, 1, (@cint)(remaining))
  end
  if ready > 0 and (event.revents & POLLIN) == 0 then return -1 end
  return ready
end

local function stop_leader(runtime: *Runtime): boolean
  if runtime.pidfd < 0 then return true end
  if not signal_child(runtime, SIGTERM) then return false end
  local ready = wait_for_exit(runtime.pidfd, 1000)
  if ready == 0 then
    if not signal_child(runtime, SIGKILL) then return false end
    ready = wait_for_exit(runtime.pidfd, 1000)
  end
  return ready > 0 and reap(runtime)
end

local function drain_cgroup(runtime: *Runtime): boolean
  local state = cgroup_state(&runtime.cgroup)
  if state == CgroupState.Empty then return true end
  if state == CgroupState.Error or not cgroup_kill(&runtime.cgroup) then return false end
  daemon_log('TE1', 'ownership', runtime.service.name, runtime.attempts, 'draining')
  local deadline = monotonic_ms() + 1000
  repeat
    state = cgroup_state(&runtime.cgroup)
    if state == CgroupState.Empty then
      daemon_log('TE1', 'ownership', runtime.service.name, runtime.attempts, 'drained')
      return true
    end
    if state == CgroupState.Error then return false end
    c_poll(nilptr, 0, 10)
  until monotonic_ms() >= deadline
  return false
end

local function stop_probe(runtime: *Runtime): boolean
  if runtime.probe_fd < 0 then return true end
  if not cancel_probe(runtime, monotonic_ms()) then return false end
  local status: cint
  return wait_for_exit(runtime.probe_fd, 1000) > 0 and reap_probe(runtime, &status)
end

local function stop_child(runtime: *Runtime): boolean
  if runtime.pidfd < 0 and runtime.probe_fd < 0 and
     runtime.state ~= ServiceState.Backoff and cgroup_state(&runtime.cgroup) == CgroupState.Empty then
    return true
  end
  transition(runtime, ServiceState.Stopping, 'shutdown')
  local probe_stopped = stop_probe(runtime)
  local leader_stopped = stop_leader(runtime)
  local group_empty = drain_cgroup(runtime)
  if not probe_stopped or not leader_stopped or not group_empty then return false end
  transition(runtime, ServiceState.Stopped, 'shutdown-complete')
  return true
end

local function terminal(state: ServiceState): boolean
  return state == ServiceState.Failed or state == ServiceState.Stopped
end

local function advance_target(group: *Supervision, child_mask: *Sigset): integer
  for i: integer = 0, group.count - 1 do
    local runtime = &group.runtimes[i]
    if group.required[i] then
      if terminal(runtime.state) then
        daemon_log('TE1', 'target', group.name, 'failed', runtime.service.name)
        return 82
      end
    end
  end

  -- Admit services in the planner's order, waiting for each startup verdict.
  while group.next_start < group.count do
    local i = group.next_start
    if i > 0 then
      local previous = group.runtimes[i - 1].state
      if previous ~= ServiceState.Running and not terminal(previous) then return 0 end
    end
    local runtime = &group.runtimes[i]
    local unavailable: integer = -1
    for j: integer = 0, i - 1 do
      if group.needs[i][j] then
        local dependency = group.runtimes[j].state
        if terminal(dependency) then unavailable = j; break end
        if dependency ~= ServiceState.Running then return 0 end
      end
    end
    if unavailable >= 0 then
      transition(runtime, ServiceState.Failed, 'dependency-failed')
      daemon_log('TE1', 'target', group.name, 'skipped', runtime.service.name,
            group.runtimes[unavailable].service.name)
    elseif not spawn(runtime, &group.arguments[i], child_mask) then
      daemon_log('TE1', 'target', group.name, 'failed', runtime.service.name)
      return 80
    end
    group.next_start = i + 1
  end
  if not group.announced then
    for i: integer = 0, group.count - 1 do
      if group.required[i] and group.runtimes[i].state ~= ServiceState.Running then return 0 end
    end
    local last = group.runtimes[group.count - 1].state
    if last == ServiceState.Running or terminal(last) then
      daemon_log('TE1', 'target', group.name, 'running')
      group.announced = true
    end
  end
  return 0
end

local function reply_services(client: cint, group: *Supervision)
  local response: stringbuilder
  defer response:destroy() end
  if not response:write('TR1\tSERVICES') then return end
  for i: integer = 0, group.count - 1 do
    local runtime = &group.runtimes[i]
    if not response:write('\t', runtime.service.name, '\t', state_name(runtime.state)) then return end
  end
  if not response:write('\n') then return end
  write_all(client, response:view())
end

local function reply_query(client: cint, request: string, group: *Supervision)
  if request == 'TQ1\tSERVICES\n' then
    reply_services(client, group)
    return
  end
  for i: integer = 0, group.count - 1 do
    local runtime = &group.runtimes[i]
    if request == runtime.status_request then
      write_status(client, runtime)
      return
    end
  end
  write_all(client, 'TR1\tERROR\trequest\n')
end

local function reap_notified_child(group: *Supervision, pid: cint): boolean
  for i: integer = 0, group.count - 1 do
    local runtime = &group.runtimes[i]
    if runtime.pid == pid then
      if runtime.execfd >= 0 and not record_exec(runtime) then return false end
      return record_exit(runtime)
    end
    if runtime.probe_pid == pid then return record_probe(runtime) end
  end

  local status: cint
  if not wait_for_child(pid, &status) then return false end
  if pid == daemon_log_pid() then daemon_log_reaped(); return true end
  local signal = status & 0x7f
  local code: integer = -1
  if signal == 0 then code = (status >> 8) & 0xff end
  daemon_log('TE1', 'process', pid, 'adopted-exit', code, signal)
  return true
end

local function reap_pending_children(group: *Supervision): (boolean, boolean)
  -- SIGCHLD can coalesce. Drain waitable children in batches so the
  -- control socket and startup deadlines also make progress under churn.
  for _: integer = 1, 64 do
    local info: ChildInfo <noinit>
    info.si_pid = 0
    local result = c_waitid(P_ALL, 0, &info, WEXITED | WNOHANG | WNOWAIT)
    while result < 0 and errno == EINTR do
      result = c_waitid(P_ALL, 0, &info, WEXITED | WNOHANG | WNOWAIT)
    end
    if result < 0 then return errno == ECHILD, false end
    if info.si_pid == 0 then return true, false end
    -- The exited child is still waitable, so this PID cannot be reused
    -- between peeking at it and routing its status.
    if not reap_notified_child(group, info.si_pid) then return false, false end
  end
  return true, true
end

local function serve(listener: cint, shutdown_fd: cint, reap_fd: cint, group: *Supervision,
                     child_mask: *Sigset): (integer, cint)
  local fds: [4 + MaxClients + 3 * NativeMaxServices]Pollfd
  local active_fds: [4 + MaxClients + 3 * NativeMaxServices]Pollfd
  local active_slots: [4 + MaxClients + 3 * NativeMaxServices]integer
  local first_child = 4 + MaxClients
  local first_exec = first_child + group.count
  local first_probe = first_exec + group.count
  local count = first_probe + group.count
  fds[0] = {fd = listener, events = POLLIN}
  fds[1] = {fd = shutdown_fd, events = POLLIN}
  fds[2] = {fd = reap_fd, events = POLLIN}
  fds[3].events = POLLOUT
  for i: integer = 0, group.count - 1 do
    fds[first_child + i].events = POLLIN
    fds[first_exec + i].events = POLLIN
    fds[first_probe + i].events = POLLIN
  end
  local clients: [MaxClients]ControlClient
  for slot: integer = 0, MaxClients - 1 do
    fds[slot + 4] = {fd = -1, events = POLLIN}
  end

  local exit_code: integer = 0
  local shutdown_client: cint = -1
  local more_exits = false
  local accept_at: integer = 0
  while true do
    local deadline: integer = 0
    fds[3].fd = daemon_log_writable_fd()
    for i: integer = 0, group.count - 1 do
      local runtime = &group.runtimes[i]
      fds[first_child + i].fd = runtime.pidfd
      fds[first_exec + i].fd = runtime.execfd
      fds[first_probe + i].fd = runtime.probe_fd
      local action = runtime.action_at
      if action ~= 0 and (deadline == 0 or action < deadline) then deadline = action end
    end
    local now = monotonic_ms()
    local free_slot: integer = -1
    for slot: integer = 0, MaxClients - 1 do
      local event = &fds[slot + 4]
      local expires = clients[slot].deadline
      if event.fd >= 0 and expires <= now then
        c_close(event.fd)
        event.fd = -1
      end
      if event.fd < 0 then free_slot = slot
      elseif deadline == 0 or expires < deadline then deadline = expires end
    end
    fds[0].fd = -1
    if free_slot >= 0 then
      if accept_at <= now then
        fds[0].fd = listener
      elseif deadline == 0 or accept_at < deadline then
        deadline = accept_at
      end
    end

    local timeout: cint = -1
    if deadline > now then timeout = (@cint)(deadline - now)
    elseif deadline ~= 0 then timeout = 0 end
    if more_exits then timeout = 0 end
    -- Linux counts inactive array entries against RLIMIT_NOFILE too.
    local active_count: integer = 0
    for slot: integer = 0, count - 1 do
      fds[slot].revents = 0
      if fds[slot].fd >= 0 then
        active_slots[active_count] = slot
        active_fds[active_count] = fds[slot]
        active_count = active_count + 1
      end
    end
    local ready = c_poll(&active_fds[0], (@culong)(active_count), timeout)
    if ready < 0 then
      if errno ~= EINTR then exit_code = 79; break end
    else
      if ready > 0 then
        for i: integer = 0, active_count - 1 do
          fds[active_slots[i]].revents = active_fds[i].revents
        end
      end
      if fds[1].revents ~= 0 then break end
      if fds[3].revents ~= 0 then flush_daemon_log_loss() end
      for i: integer = 0, group.count - 1 do
        local runtime = &group.runtimes[i]
        local event = fds[first_child + i].revents
        -- Process the handshake before the exit, even when a fast child exits
        -- after poll reported only its pidfd.
        if runtime.execfd >= 0 and (fds[first_exec + i].revents ~= 0 or event ~= 0) and
           not record_exec(runtime) then
          exit_code = 80
          break
        end
        if event ~= 0 and ((event & POLLIN) == 0 or not record_exit(runtime)) then
          exit_code = 80
          break
        end
        local probe_event = fds[first_probe + i].revents
        if probe_event ~= 0 and ((probe_event & POLLIN) == 0 or not record_probe(runtime)) then
          exit_code = 80
          break
        end
      end
      if exit_code ~= 0 then break end

      if fds[2].revents ~= 0 then
        if (fds[2].revents & POLLIN) == 0 or not read_child_signal(reap_fd) then exit_code = 80; break end
        more_exits = true
      end
      if more_exits then
        local ok: boolean
        ok, more_exits = reap_pending_children(group)
        if not ok then exit_code = 80; break end
      end

      for slot: integer = 0, MaxClients - 1 do
        local event = &fds[slot + 4]
        if event.revents == 0 then continue end
        local state, request = read_request(event.fd, &clients[slot])
        if state == RequestState.Pending then continue end
        if state == RequestState.Complete and request == 'TQ1\tSHUTDOWN\n' then
          shutdown_client = event.fd
          event.fd = -1
          break
        end
        if state == RequestState.Complete then
          reply_query(event.fd, request, group)
        elseif state ~= RequestState.Closed then
          write_all(event.fd, 'TR1\tERROR\trequest\n')
        end
        c_close(event.fd)
        event.fd = -1
      end
      if shutdown_client >= 0 then break end

      if (fds[0].revents & POLLIN) ~= 0 then
        local fd = c_accept4(listener, nilptr, nilptr, SOCK_CLOEXEC | SOCK_NONBLOCK)
        if fd >= 0 then
          fds[free_slot + 4].fd = fd
          clients[free_slot].used = 0
          clients[free_slot].deadline = monotonic_ms() + ControlTimeout
        elseif errno == EMFILE or errno == ENFILE then
          -- A queued connection keeps the listener readable during exhaustion.
          accept_at = monotonic_ms() + AcceptRetryMs
        elseif errno ~= EAGAIN and errno ~= EINTR then exit_code = 79; break end
      elseif fds[0].revents ~= 0 then exit_code = 79; break end

      for i: integer = 0, group.count - 1 do
        if not advance_service(&group.runtimes[i], &group.arguments[i], child_mask) then
          exit_code = 80
          break
        end
      end
      if exit_code ~= 0 then break end
      if group.target then
        exit_code = advance_target(group, child_mask)
        if exit_code ~= 0 then break end
      end
    end
  end

  for slot: integer = 0, MaxClients - 1 do
    local fd = fds[slot + 4].fd
    if fd >= 0 then c_close(fd) end
  end
  return exit_code, shutdown_client
end

local function log_graph_diagnostic(message: string)
  daemon_log_error(message)
end

local function load_target(name: string, group: *Supervision): integer
  local path = os.getenv('THESEUS_GRAPH')
  if #path == 0 then path = './build/graph.tsc' end
  local graph: NativeGraph
  set_native_graph_diagnostics(log_graph_diagnostic)
  if not load_native_graph(path, &graph) then return 65 end
  local plan: NativePlan
  local code = plan_native_target(&graph, name, &plan)
  if code ~= 0 then return code end
  group.count = plan.count
  group.needs = plan.needs
  for i: integer = 0, plan.count - 1 do
    local member = plan.order[i]
    local ok, service = parse_runtime_service(graph.services[member].runtime_record)
    if not ok then
      daemon_log_error('theseusd: invalid runtime fields for ', graph.services[member].name, '\n')
      return 65
    end
    group.runtimes[i].service = service
    group.required[i] = plan.required[member]
  end
  return 0
end

local function load_single(name: string, group: *Supervision): integer
  local records = os.getenv('THESEUS_RECORDS')
  if #records == 0 then records = './build/services.tsc' end
  local ok, service = load_service(records, name)
  if not ok then daemon_log_error('theseusd: unknown service: ', name, '\n'); return 3 end
  group.count = 1
  group.runtimes[0].service = service
  return 0
end

local function prepare(group: *Supervision, path: string): integer
  local readiness_paths: RuntimeReadinessPaths
  for i: integer = 0, group.count - 1 do
    local runtime = &group.runtimes[i]
    local code, message = prepare_runtime_service(&runtime.service, &group.arguments[i],
                                                  &runtime.probe_args, path, &readiness_paths)
    if code ~= 0 then daemon_log_error('theseusd: ', message, '\n'); return code end
    runtime.pidfd = -1
    runtime.execfd = -1
    runtime.probe_fd = -1
    runtime.last_exit = -1
    runtime.status_request = 'TQ1\tSTATUS\t' .. runtime.service.name .. '\n'
  end
  if readiness_paths.count > 0 and not peer_pidfd_available() then
    daemon_log_error('theseusd: unix-socket readiness requires kernel SO_PEERPIDFD support\n')
    return 69
  end
  return 0
end

local function supervise(shutdown_fd: cint, reap_fd: cint, child_mask: *Sigset): integer
  local group: Supervision
  local code: integer
  if #arg == 2 and arg[1] == '--target' then
    group.target = true
    group.name = arg[2]
    code = load_target(group.name, &group)
  elseif #arg == 1 and arg[1] ~= '--target' then
    group.name = arg[1]
    code = load_single(group.name, &group)
  else
    daemon_log_error('usage: theseusd SERVICE | theseusd --target TARGET\n')
    return 64
  end
  if code ~= 0 then return code end
  local path = socket_path()
  if #path == 0 then return 64 end
  code = prepare(&group, path)
  if code ~= 0 then return code end

  local recovery_dir = os.getenv('THESEUS_RECOVERY_DIR')
  local recoverable = #recovery_dir > 0
  if not recoverable and c_access((@cstring)(path), 0) == 0 then
    daemon_log_error('theseusd: refusing pre-existing control socket path: ', path, '\n')
    return 73
  end
  local root: cint = -1
  local delegation = os.getenv('THESEUS_CGROUP_ROOT')
  if #delegation > 0 then
    root = cgroup_open_root(delegation)
    if root < 0 then
      daemon_log_error('theseusd: invalid cgroup v2 delegation: ', delegation, '\n')
      return 83
    end
  end
  local delegated_root = root
  defer
    if delegated_root >= 0 then c_close(delegated_root) end
  end
  local instance: RecoverableInstance = {dir = -1, scope = -1}
  defer recovery_close(&instance) end
  local bind_path = path
  if recoverable then
    code = recovery_begin(&instance, path, recovery_dir, delegated_root)
    if code ~= 0 then
      daemon_log_error('theseusd: cannot claim recovery directory: ', recovery_dir, ' (exit ', code, ')\n')
      return code
    end
    if instance.recovered then daemon_log('TE1', 'recovery', group.name, 'cleaned') end
    root = instance.scope
    bind_path = recovery_bind_path(&instance)
  end
  local listener = c_socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0)
  if listener < 0 then return 74 end
  local address: SockaddrUn
  fill_address(&address, bind_path)
  -- Create the socket with mode 0600. There is no wider-access bind window.
  local previous_mask = c_umask(0x7f) -- octal 0177
  local bound = c_bind(listener, &address, (@cuint)(2 + #bind_path + 1))
  c_umask(previous_mask)
  if bound ~= 0 then c_close(listener); return 75 end
  if c_listen(listener, 8) ~= 0 or (recoverable and not recovery_publish(&instance)) then
    c_close(listener)
    if not recoverable then c_unlink((@cstring)(path)) end
    return 77
  end

  local exit_code: integer = 78
  local shutdown_client: cint = -1
  local resources_ready = true
  if root >= 0 then
    for i: integer = 0, group.count - 1 do
      local runtime = &group.runtimes[i]
      if not cgroup_create(root, i, &runtime.cgroup, recoverable) then
        daemon_log_error('theseusd: cannot create cgroup for ', runtime.service.name, '\n')
        exit_code = 83
        resources_ready = false
        break
      end
      daemon_log('TE1', 'ownership', runtime.service.name, 0, 'assigned', runtime.cgroup.name)
    end
  end
  if resources_ready then
    if group.target then
      exit_code = advance_target(&group, child_mask)
    elseif spawn(&group.runtimes[0], &group.arguments[0], child_mask) then
      exit_code = 0
    end
    if exit_code == 0 then
      exit_code, shutdown_client = serve(listener, shutdown_fd, reap_fd, &group, child_mask)
    end
  end

  c_close(listener)
  local stopped = true
  for i: integer = group.count - 1, 0, -1 do
    local runtime = &group.runtimes[i]
    if runtime.pidfd >= 0 and group.target then
      daemon_log('TE1', 'target', group.name, 'stopping', runtime.service.name)
    end
    if resources_ready and not stop_child(runtime) then stopped = false end
    if root >= 0 and not cgroup_remove(root, &runtime.cgroup) then
      daemon_log_error('theseusd: cannot remove cgroup for ', runtime.service.name, '\n')
      stopped = false
    end
  end
  local more = true
  local reap_deadline = monotonic_ms() + 1000
  while more do
    local ok: boolean
    ok, more = reap_pending_children(&group)
    if not ok or (more and monotonic_ms() >= reap_deadline) then stopped = false; break end
  end
  if recoverable then
    if stopped and not recovery_finish(&instance, delegated_root) then stopped = false end
  else
    c_unlink((@cstring)(path))
  end
  if shutdown_client >= 0 then
    if stopped then write_all(shutdown_client, 'TR1\tOK\n')
    else write_all(shutdown_client, 'TR1\tERROR\tshutdown\n') end
    c_close(shutdown_client)
  end
  if not stopped then
    daemon_log_error('theseusd: failed to complete child cleanup\n')
    return 81
  end
  if group.target then daemon_log('TE1', 'target', group.name, 'stopped', exit_code) end
  daemon_log('daemon-stopped', group.name)
  return exit_code
end

local function main(): integer
  local child_mask: Sigset
  local shutdown_fd = open_shutdown_fd(&child_mask)
  if shutdown_fd < 0 then return 74 end
  if not start_daemon_log() then return 85 end
  local reap_fd = open_reap_fd()
  if reap_fd < 0 then
    daemon_log_error('theseusd: cannot enable child subreaping\n')
    c_close(shutdown_fd)
    finish_daemon_log()
    return 84
  end
  local result = supervise(shutdown_fd, reap_fd, &child_mask)
  c_close(reap_fd)
  c_close(shutdown_fd)
  finish_daemon_log()
  return result
end

os.exit(main())
