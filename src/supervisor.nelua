## cflags '-D_GNU_SOURCE'

-- Long-lived Theseus userspace supervisor.
-- Maintained implementation is Nelua; CUE is compiled away before runtime.

require 'arg'
require 'io'
require 'math'
require 'os'
require 'string'

local function c_fork(): cint <cimport 'fork', nodecl, cinclude '<unistd.h>'> end
local function c_execvp(file: cstring, argv: *cstring): cint <cimport 'execvp', nodecl, cinclude '<unistd.h>'> end
local function c__exit(status: cint): void <cimport '_exit', nodecl, cinclude '<unistd.h>'> end
local function c_waitpid(pid: cint, status: *cint, options: cint): cint <cimport 'waitpid', nodecl, cinclude '<sys/wait.h>'> end
local function c_close(fd: cint): cint <cimport 'close', nodecl, cinclude '<unistd.h>'> end
local function c_kill(pid: cint, signal: cint): cint <cimport 'kill', nodecl, cinclude '<signal.h>'> end
local function c_syscall2(number: clong, a1: clong, a2: clong): clong <cimport 'syscall', nodecl, cinclude '<unistd.h>'> end
local function c_syscall4(number: clong, a1: clong, a2: clong, a3: pointer, a4: clong): clong <cimport 'syscall', nodecl, cinclude '<unistd.h>'> end
local function c_socket(domain: cint, kind: cint, protocol: cint): cint <cimport 'socket', nodecl, cinclude '<sys/socket.h>'> end
local function c_connect(fd: cint, address: pointer, length: cuint): cint <cimport 'connect', nodecl, cinclude '<sys/socket.h>'> end
local function c_socketpair(domain: cint, kind: cint, protocol: cint, fds: *cint): cint <cimport 'socketpair', nodecl, cinclude '<sys/socket.h>'> end
local function c_getsockopt(fd: cint, level: cint, option: cint, value: pointer, length: *cuint): cint <cimport 'getsockopt', nodecl, cinclude '<sys/socket.h>'> end
local function c_bind(fd: cint, address: pointer, length: cuint): cint <cimport 'bind', nodecl, cinclude '<sys/socket.h>'> end
local function c_listen(fd: cint, backlog: cint): cint <cimport 'listen', nodecl, cinclude '<sys/socket.h>'> end
local function c_accept4(fd: cint, address: pointer, length: pointer, flags: cint): cint <cimport 'accept4', nodecl, cinclude '<sys/socket.h>'> end
local function c_read(fd: cint, buffer: pointer, count: csize): clong <cimport 'read', nodecl, cinclude '<unistd.h>'> end
local function c_send(fd: cint, buffer: pointer, count: csize, flags: cint): clong <cimport 'send', nodecl, cinclude '<sys/socket.h>'> end
local function c_unlink(path: cstring): cint <cimport 'unlink', nodecl, cinclude '<unistd.h>'> end
local function c_access(path: cstring, mode: cint): cint <cimport 'access', nodecl, cinclude '<unistd.h>'> end
local function c_umask(mode: cuint): cuint <cimport 'umask', nodecl, cinclude '<sys/stat.h>'> end

local SignalHandler = @function(cint): void
local function c_signal(signal: cint, handler: SignalHandler): SignalHandler <cimport 'signal', nodecl, cinclude '<signal.h>'> end
local Sigset: type <cimport 'sigset_t', nodecl, cinclude '<signal.h>'> = @record{}
local Timespec: type <cimport 'struct timespec', nodecl, cinclude '<time.h>'> = @record{tv_sec: clong, tv_nsec: clong}
local function c_sigemptyset(set: *Sigset): cint <cimport 'sigemptyset', nodecl, cinclude '<signal.h>'> end
local function c_sigaddset(set: *Sigset, signal: cint): cint <cimport 'sigaddset', nodecl, cinclude '<signal.h>'> end
local function c_sigprocmask(how: cint, set: *Sigset, previous: *Sigset): cint <cimport 'sigprocmask', nodecl, cinclude '<signal.h>'> end
local function c_signalfd(fd: cint, set: *Sigset, flags: cint): cint <cimport 'signalfd', nodecl, cinclude '<sys/signalfd.h>'> end
local function c_clock_gettime(clock: cint, value: *Timespec): cint <cimport 'clock_gettime', nodecl, cinclude '<time.h>'> end

local Pollfd = @record{fd: cint, events: cshort, revents: cshort}
local function c_poll(fds: *Pollfd, count: culong, timeout_ms: cint): cint <cimport 'poll', nodecl, cinclude '<poll.h>'> end

local Credentials: type <cimport 'struct ucred', nodecl, cinclude '<sys/socket.h>'> = @record{
  pid: cint, uid: cuint, gid: cuint,
}
local SOL_SOCKET: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SO_PEERCRED: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
-- Linux's generic UAPI value also works with libc headers predating the option.
local PeerPidfdOption <comptime> = 77
local AF_UNIX: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_STREAM: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_CLOEXEC: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SOCK_NONBLOCK: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local MSG_NOSIGNAL: cint <cimport, nodecl, cinclude '<sys/socket.h>'>
local SIG_BLOCK: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIG_SETMASK: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGCHLD: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIG_DFL: SignalHandler <cimport, nodecl, cinclude '<signal.h>'>
local SIG_ERR: SignalHandler <cimport, nodecl, cinclude '<signal.h>'>
local SIGINT: cint <cimport, nodecl, cinclude '<signal.h>'>
local SFD_CLOEXEC: cint <cimport, nodecl, cinclude '<sys/signalfd.h>'>
local CLOCK_MONOTONIC: cint <cimport, nodecl, cinclude '<time.h>'>
local errno: cint <cimport, nodecl, cinclude '<errno.h>'>
local EINTR: cint <cimport, nodecl, cinclude '<errno.h>'>
local EAGAIN: cint <cimport, nodecl, cinclude '<errno.h>'>
local ESRCH: cint <cimport, nodecl, cinclude '<errno.h>'>
local POLLIN: cshort <cimport, nodecl, cinclude '<poll.h>'>
local SYS_pidfd_open: clong <cimport, nodecl, cinclude '<sys/syscall.h>'>
local SYS_pidfd_send_signal: clong <cimport, nodecl, cinclude '<sys/syscall.h>'>
local SIGTERM: cint <cimport, nodecl, cinclude '<signal.h>'>
local SIGKILL: cint <cimport, nodecl, cinclude '<signal.h>'>

local SockaddrUn = @record{sun_family: cushort, sun_path: [108]cchar}
local ServiceState = @enum{Planned = 0, Starting, Ready, Running, Stopped, Failed, Backoff, Stopping}
local RestartPolicy = @enum{Never = 0, OnFailure, Always}
local ReadinessKind = @enum{None = 0, Pid, UnixSocket}

local Service = @record{
  name: string,
  argv_serialized: string,
  restart: RestartPolicy,
  max_restarts: integer,
  readiness: ReadinessKind,
  readiness_path: string,
  readiness_timeout: integer,
}

local ExecArgv = @record{
  storage: [32]string,
  cargs: [33]cstring,
  count: integer,
}

local Runtime = @record{
  service: Service,
  state: ServiceState,
  pid: cint,
  pidfd: cint,
  attempts: integer,
  restarts: integer,
  action_at: integer,
  ready_by: integer,
  kill_sent: boolean,
  last_exit: integer,
  last_signal: integer,
}

local function state_name(state: ServiceState): string
  if state == ServiceState.Planned then return 'PLANNED' end
  if state == ServiceState.Starting then return 'STARTING' end
  if state == ServiceState.Ready then return 'READY' end
  if state == ServiceState.Running then return 'RUNNING' end
  if state == ServiceState.Stopped then return 'STOPPED' end
  if state == ServiceState.Failed then return 'FAILED' end
  if state == ServiceState.Backoff then return 'BACKOFF' end
  if state == ServiceState.Stopping then return 'STOPPING' end
  return 'UNKNOWN'
end

local function next_field(line: string, cursor: isize): (string, isize)
  local first, last = string.find(line, '\t', cursor, true)
  if first == 0 then return string.sub(line, cursor), 0 end
  return string.sub(line, cursor, first - 1), last + 1
end

local function parse_decimal(text: string, maximum: integer): (boolean, integer)
  if #text == 0 then return false, 0 end
  local value: integer = 0
  for i: isize = 1, #text do
    local byte = string.byte(text, i)
    if byte < 48 or byte > 57 then return false, 0 end
    value = value * 10 + byte - 48
    if value > maximum then return false, 0 end
  end
  return true, value
end

local function parse_service(line: string): (boolean, Service)
  local service: Service
  local cursor: isize = 1
  local magic: string
  magic, cursor = next_field(line, cursor)
  if (magic ~= 'TSC2' and magic ~= 'TSC4') or cursor == 0 then return false, service end
  service.name, cursor = next_field(line, cursor)
  if #service.name == 0 or cursor == 0 then return false, service end
  service.argv_serialized, cursor = next_field(line, cursor)
  if #service.argv_serialized == 0 or cursor == 0 then return false, service end
  local restart: string
  restart, cursor = next_field(line, cursor)
  if restart == 'never' then service.restart = RestartPolicy.Never
  elseif restart == 'on-failure' then service.restart = RestartPolicy.OnFailure
  elseif restart == 'always' then service.restart = RestartPolicy.Always
  else return false, service end
  if cursor == 0 then return false, service end
  local maximum: string
  maximum, cursor = next_field(line, cursor)
  if cursor == 0 then return false, service end
  local ok: boolean
  ok, service.max_restarts = parse_decimal(maximum, 1000000)
  if not ok then return false, service end
  local readiness: string
  readiness, cursor = next_field(line, cursor)
  if readiness == 'none' then service.readiness = ReadinessKind.None
  elseif readiness == 'pid' then service.readiness = ReadinessKind.Pid
  elseif readiness == 'unix-socket' then service.readiness = ReadinessKind.UnixSocket
  else return false, service end
  if magic == 'TSC4' then
    if service.readiness ~= ReadinessKind.UnixSocket or cursor == 0 then return false, service end
    service.readiness_path, cursor = next_field(line, cursor)
    if cursor == 0 or #service.readiness_path == 0 or #service.readiness_path > 107 or
       string.byte(service.readiness_path, 1) ~= 47 or string.find(service.readiness_path, '\0', 1, true) ~= 0 then return false, service end
    local timeout: string
    timeout, cursor = next_field(line, cursor)
    ok, service.readiness_timeout = parse_decimal(timeout, 600000)
    if not ok or service.readiness_timeout < 1 then return false, service end
  end
  if cursor ~= 0 then return false, service end
  return true, service
end

local function decode_argv(serialized: string, out: *ExecArgv): boolean
  local cursor: isize = 1
  local count: integer = 0
  while cursor ~= 0 do
    if count >= 32 then return false end
    local first, last = string.find(serialized, '\31', cursor, true)
    local item: string
    if first == 0 then item = string.sub(serialized, cursor); cursor = 0
    else item = string.sub(serialized, cursor, first - 1); cursor = last + 1 end
    if (count == 0 and #item == 0) or string.find(item, '\0', 1, true) ~= 0 then
      return false
    end
    out.storage[count] = item
    out.cargs[count] = (@cstring)(out.storage[count])
    count = count + 1
  end
  if count == 0 then return false end
  out.cargs[count] = nilptr
  out.count = count
  return true
end

local function load_service(path: string, wanted: string): (boolean, Service)
  local file = io.open(path, 'r')
  if not file:isopen() then local empty: Service; return false, empty end
  for line in file:lines() do
    local ok: boolean
    local service: Service
    ok, service = parse_service(line)
    if ok and service.name == wanted then file:close(); return true, service end
  end
  file:close()
  local empty: Service
  return false, empty
end

local function pidfd_open_for(pid: cint): cint
  return (@cint)(c_syscall2(SYS_pidfd_open, (@clong)(pid), 0))
end

local function pidfd_send_signal(fd: cint, signal: cint): boolean
  return c_syscall4(SYS_pidfd_send_signal, (@clong)(fd), (@clong)(signal), nilptr, 0) == 0
end

local function decode_wait(status: cint, runtime: *Runtime)
  local term = status & 0x7f
  if term == 0 then
    runtime.last_exit = (status >> 8) & 0xff
    runtime.last_signal = 0
  else
    runtime.last_exit = -1
    runtime.last_signal = term
  end
end

local function monotonic_ms(): integer
  local now: Timespec
  c_clock_gettime(CLOCK_MONOTONIC, &now)
  return (@integer)(now.tv_sec) * 1000 + now.tv_nsec // 1000000
end

local function open_shutdown_fd(child_mask: *Sigset): cint
  -- A launcher can pass down SIG_IGN. Keep each child waitable until reaped.
  if c_signal(SIGCHLD, SIG_DFL) == SIG_ERR then return -1 end
  local mask: Sigset
  if c_sigemptyset(&mask) ~= 0 or c_sigaddset(&mask, SIGTERM) ~= 0 or
     c_sigaddset(&mask, SIGINT) ~= 0 or c_sigprocmask(SIG_BLOCK, &mask, child_mask) ~= 0 then
    return -1
  end
  return c_signalfd(-1, &mask, SFD_CLOEXEC)
end

local function wait_for_child(pid: cint, status: *cint): boolean
  local waited = c_waitpid(pid, status, 0)
  while waited < 0 and errno == EINTR do
    waited = c_waitpid(pid, status, 0)
  end
  return waited == pid
end

local function spawn(runtime: *Runtime, argv: *ExecArgv, child_mask: *Sigset): boolean
  runtime.state = ServiceState.Starting
  runtime.attempts = runtime.attempts + 1
  local pid = c_fork()
  if pid == 0 then
    if c_sigprocmask(SIG_SETMASK, child_mask, nilptr) == 0 then
      c_execvp(argv.cargs[0], &argv.cargs[0])
    end
    c__exit(127)
  end
  if pid < 0 then runtime.state = ServiceState.Failed; return false end
  local pidfd = pidfd_open_for(pid)
  if pidfd < 0 then
    c_kill(pid, SIGKILL)
    local status: cint = 0
    wait_for_child(pid, &status)
    runtime.state = ServiceState.Failed
    return false
  end
  runtime.pid = pid
  runtime.pidfd = pidfd
  if runtime.service.readiness == ReadinessKind.UnixSocket then
    runtime.action_at = monotonic_ms()
    runtime.ready_by = runtime.action_at + runtime.service.readiness_timeout
  else
    if runtime.service.readiness == ReadinessKind.Pid then runtime.state = ServiceState.Ready end
    runtime.state = ServiceState.Running
  end
  print('daemon-spawn', runtime.service.name, 'pid', pid, 'pidfd', pidfd, 'attempt', runtime.attempts)
  return true
end

local function should_restart(runtime: *Runtime): boolean
  if runtime.service.restart == RestartPolicy.Always then return true end
  if runtime.service.restart == RestartPolicy.OnFailure then
    return runtime.state == ServiceState.Failed
  end
  return false
end

local function reap(runtime: *Runtime): boolean
  local status: cint = 0
  if not wait_for_child(runtime.pid, &status) then return false end
  c_close(runtime.pidfd)
  runtime.pidfd = -1
  runtime.pid = 0
  decode_wait(status, runtime)
  return true
end

local function record_exit(runtime: *Runtime): boolean
  local premature = runtime.state == ServiceState.Starting or runtime.state == ServiceState.Stopping
  if not reap(runtime) then return false end
  if runtime.state == ServiceState.Starting then
    print('TE1', 'readiness', runtime.service.name, runtime.attempts, 'exited-before-ready')
  end
  runtime.action_at = 0
  print('daemon-exit', runtime.service.name, 'code', runtime.last_exit, 'signal', runtime.last_signal)
  if premature or runtime.last_exit ~= 0 or runtime.last_signal ~= 0 then
    runtime.state = ServiceState.Failed
  else
    runtime.state = ServiceState.Stopped
  end
  if should_restart(runtime) and runtime.restarts < runtime.service.max_restarts then
    local delay = (runtime.restarts + 1) * 10
    if delay > 1000 then delay = 1000 end
    runtime.action_at = monotonic_ms() + delay
    runtime.state = ServiceState.Backoff
  end
  return true
end

local function socket_path(): string
  local path = os.getenv('THESEUS_SOCKET')
  if #path == 0 then io.stderr:write('theseusd: THESEUS_SOCKET is required in userspace mode\n'); os.exit(64) end
  if #path > 100 or string.byte(path, 1) ~= 47 then
    io.stderr:write('theseusd: socket path must be absolute and <=100 bytes\n')
    os.exit(64)
  end
  return path
end

local function fill_address(address: *SockaddrUn, path: string)
  address.sun_family = (@cushort)(AF_UNIX)
  for i: integer = 0, 107 do address.sun_path[i] = 0 end
  for i: isize = 1, #path do address.sun_path[i - 1] = (@cchar)(string.byte(path, i)) end
end

local function peer_pidfd(socket: cint): cint
  local fd: cint = -1
  local size = (@cuint)(#cint)
  if c_getsockopt(socket, SOL_SOCKET, PeerPidfdOption, &fd, &size) ~= 0 then return -1 end
  return fd
end

local function peer_pidfd_available(): boolean
  local pair: [2]cint
  if c_socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, &pair[0]) ~= 0 then return false end
  local peer = peer_pidfd(pair[0])
  c_close(pair[0])
  c_close(pair[1])
  if peer < 0 then return false end
  c_close(peer)
  return true
end

local function has_ready_peer(runtime: *Runtime): boolean
  local probe = c_socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0)
  if probe < 0 then return false end
  local path = runtime.service.readiness_path
  local address: SockaddrUn
  fill_address(&address, path)
  local ready = false
  if c_connect(probe, &address, (@cuint)(2 + #path + 1)) == 0 then
    local credentials: Credentials
    local size = (@cuint)(#Credentials)
    if c_getsockopt(probe, SOL_SOCKET, SO_PEERCRED, &credentials, &size) == 0 and
       credentials.pid == runtime.pid then
      local peer = peer_pidfd(probe)
      if peer >= 0 then
        -- A dead listener's credentials can retain a recycled numeric PID.
        -- The peer must be alive while our own child still owns that PID.
        local event: Pollfd = {fd = peer, events = POLLIN}
        ready = c_poll(&event, 1, 0) == 0
        c_close(peer)
      end
    end
  end
  c_close(probe)
  return ready
end

local function signal_child(runtime: *Runtime, signal: cint): boolean
  return pidfd_send_signal(runtime.pidfd, signal) or errno == ESRCH
end

local function advance_service(runtime: *Runtime, argv: *ExecArgv, child_mask: *Sigset): boolean
  local now = monotonic_ms()
  if runtime.action_at == 0 or now < runtime.action_at then return true end
  if runtime.state == ServiceState.Backoff then
    runtime.action_at = 0
    runtime.restarts = runtime.restarts + 1
    return spawn(runtime, argv, child_mask)
  end
  if runtime.state == ServiceState.Starting then
    if now >= runtime.ready_by then
      print('TE1', 'readiness', runtime.service.name, runtime.attempts, 'timeout')
      runtime.state = ServiceState.Stopping
      runtime.kill_sent = false
      runtime.action_at = now + 1000
      return signal_child(runtime, SIGTERM)
    end
    if has_ready_peer(runtime) then
      runtime.state = ServiceState.Ready
      print('TE1', 'readiness', runtime.service.name, runtime.attempts, 'ready')
      runtime.state = ServiceState.Running
      runtime.action_at = 0
    else
      runtime.action_at = math.min(now + 25, runtime.ready_by)
    end
    return true
  end
  -- The startup timed out. Keep serving control requests while the child stops.
  if runtime.state == ServiceState.Stopping and not runtime.kill_sent then
    runtime.kill_sent = true
    runtime.action_at = now + 1000
    return signal_child(runtime, SIGKILL)
  end
  io.stderr:write('theseusd: could not stop child after readiness timeout\n')
  return false
end

local function write_all(fd: cint, text: string): boolean
  local remaining = text
  while #remaining > 0 do
    local wrote = c_send(fd, (@cstring)(remaining), (@csize)(#remaining), MSG_NOSIGNAL)
    if wrote <= 0 then return false end
    if wrote == #remaining then return true end
    remaining = string.sub(remaining, wrote + 1)
  end
  return true
end

local ControlClient = @record{
  buffer: [255]cchar,
  used: integer,
  deadline: integer,
}
local RequestState = @enum{Pending = 0, Complete, Closed, Invalid}
local ControlTimeout <comptime> = 1000
local MaxClients <comptime> = 8

local function read_request(fd: cint, client: *ControlClient): (RequestState, string)
  local got = c_read(fd, &client.buffer[client.used], (@csize)(255 - client.used))
  if got < 0 and (errno == EAGAIN or errno == EINTR) then return RequestState.Pending, '' end
  if got <= 0 then return RequestState.Closed, '' end
  local end_at = client.used + got
  for i: integer = client.used, end_at - 1 do
    if client.buffer[i] == 10 then
      local length: usize = (@usize)(i + 1)
      return RequestState.Complete, (@string){data=&client.buffer[0], size=length}
    end
  end
  client.used = end_at
  if client.used == 255 then return RequestState.Invalid, '' end
  return RequestState.Pending, ''
end

local function write_status(fd: cint, runtime: *Runtime): boolean
  local pid = tostring(runtime.pid)
  local pidfd = tostring(runtime.pidfd)
  local restarts = tostring(runtime.restarts)
  local last_exit = tostring(runtime.last_exit)
  local last_signal = tostring(runtime.last_signal)
  return write_all(fd, 'TR1\tSTATUS\t') and
    write_all(fd, runtime.service.name) and write_all(fd, '\t') and
    write_all(fd, state_name(runtime.state)) and write_all(fd, '\t') and
    write_all(fd, pid) and write_all(fd, '\t') and
    write_all(fd, pidfd) and write_all(fd, '\t') and
    write_all(fd, restarts) and write_all(fd, '\t') and
    write_all(fd, last_exit) and write_all(fd, '\t') and
    write_all(fd, last_signal) and write_all(fd, '\n')
end

local function wait_for_exit(fd: cint, timeout: integer): cint
  local event: Pollfd = {fd = fd, events = POLLIN}
  local deadline = monotonic_ms() + timeout
  local ready = c_poll(&event, 1, (@cint)(timeout))
  while ready < 0 and errno == EINTR do
    local remaining = deadline - monotonic_ms()
    if remaining <= 0 then return 0 end
    ready = c_poll(&event, 1, (@cint)(remaining))
  end
  if ready > 0 and (event.revents & POLLIN) == 0 then return -1 end
  return ready
end

local function stop_child(runtime: *Runtime): boolean
  if runtime.pidfd < 0 then return true end
  runtime.state = ServiceState.Stopping
  -- ESRCH is expected if the child exits before the signal is sent.
  if not signal_child(runtime, SIGTERM) then return false end
  local ready = wait_for_exit(runtime.pidfd, 1000)
  if ready == 0 then
    if not signal_child(runtime, SIGKILL) then return false end
    ready = wait_for_exit(runtime.pidfd, 1000)
  end
  if ready <= 0 or not reap(runtime) then return false end
  runtime.state = ServiceState.Stopped
  return true
end

local function serve(listener: cint, shutdown_fd: cint, runtime: *Runtime, argv: *ExecArgv,
                     child_mask: *Sigset): (integer, cint)
  local fds: [3 + MaxClients]Pollfd
  fds[0] = {fd = listener, events = POLLIN}
  fds[1] = {fd = shutdown_fd, events = POLLIN}
  fds[2].events = POLLIN
  local clients: [MaxClients]ControlClient
  for slot: integer = 0, MaxClients - 1 do
    fds[slot + 3] = {fd = -1, events = POLLIN}
  end

  local exit_code: integer = 0
  local shutdown_client: cint = -1
  local status_request = 'TQ1\tSTATUS\t' .. runtime.service.name .. '\n'
  while true do
    fds[2].fd = runtime.pidfd
    local deadline = runtime.action_at
    local now = monotonic_ms()
    local free_slot: integer = -1
    for slot: integer = 0, MaxClients - 1 do
      local event = &fds[slot + 3]
      local expires = clients[slot].deadline
      if event.fd >= 0 and expires <= now then
        c_close(event.fd)
        event.fd = -1
      end
      if event.fd < 0 then free_slot = slot
      elseif deadline == 0 or expires < deadline then deadline = expires end
    end
    fds[0].fd = listener
    if free_slot < 0 then fds[0].fd = -1 end

    local timeout: cint = -1
    if deadline > now then timeout = (@cint)(deadline - now)
    elseif deadline ~= 0 then timeout = 0 end
    local ready = c_poll(&fds[0], 3 + MaxClients, timeout)
    if ready < 0 then
      if errno ~= EINTR then exit_code = 79; break end
    else
      if fds[1].revents ~= 0 then break end
      if fds[2].revents ~= 0 then
        if (fds[2].revents & POLLIN) == 0 or not record_exit(runtime) then exit_code = 80; break end
      end

      for slot: integer = 0, MaxClients - 1 do
        local event = &fds[slot + 3]
        if event.revents == 0 then continue end
        local state, request = read_request(event.fd, &clients[slot])
        if state == RequestState.Pending then continue end
        if state == RequestState.Complete and request == 'TQ1\tSHUTDOWN\n' then
          shutdown_client = event.fd
          event.fd = -1
          break
        end
        if state == RequestState.Complete and request == status_request then
          write_status(event.fd, runtime)
        elseif state ~= RequestState.Closed then
          write_all(event.fd, 'TR1\tERROR\trequest\n')
        end
        c_close(event.fd)
        event.fd = -1
      end
      if shutdown_client >= 0 then break end

      if (fds[0].revents & POLLIN) ~= 0 then
        local fd = c_accept4(listener, nilptr, nilptr, SOCK_CLOEXEC | SOCK_NONBLOCK)
        if fd >= 0 then
          fds[free_slot + 3].fd = fd
          clients[free_slot].used = 0
          clients[free_slot].deadline = monotonic_ms() + ControlTimeout
        elseif errno ~= EAGAIN and errno ~= EINTR then exit_code = 79; break end
      elseif fds[0].revents ~= 0 then exit_code = 79; break end

      if not advance_service(runtime, argv, child_mask) then exit_code = 80; break end
    end
  end

  for slot: integer = 0, MaxClients - 1 do
    local fd = fds[slot + 3].fd
    if fd >= 0 then c_close(fd) end
  end
  return exit_code, shutdown_client
end

local function main(): integer
  if #arg ~= 1 then io.stderr:write('usage: theseusd SERVICE\n'); return 64 end
  local records = os.getenv('THESEUS_RECORDS')
  if #records == 0 then records = './build/services.tsc' end
  local ok: boolean
  local service: Service
  ok, service = load_service(records, arg[1])
  if not ok then io.stderr:write('theseusd: unknown service: ', arg[1], '\n'); return 3 end
  if service.readiness == ReadinessKind.UnixSocket then
    if #service.readiness_path == 0 then
      io.stderr:write('theseusd: recompile the service to supply its unix-socket readiness path\n')
      return 69
    end
    if not peer_pidfd_available() then
      io.stderr:write('theseusd: unix-socket readiness requires kernel SO_PEERPIDFD support\n')
      return 69
    end
  end
  local argv: ExecArgv
  if not decode_argv(service.argv_serialized, &argv) then return 65 end

  local path = socket_path()
  if service.readiness_path == path then
    io.stderr:write('theseusd: readiness and control sockets need distinct paths\n')
    return 65
  end
  if c_access((@cstring)(path), 0) == 0 then
    io.stderr:write('theseusd: refusing pre-existing control socket path: ', path, '\n')
    return 73
  end
  local child_mask: Sigset
  local shutdown_fd = open_shutdown_fd(&child_mask)
  if shutdown_fd < 0 then return 74 end
  local listener = c_socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0)
  if listener < 0 then return 74 end
  local address: SockaddrUn
  fill_address(&address, path)
  -- Create the socket with mode 0600. There is no wider-access bind window.
  local previous_mask = c_umask(0x7f) -- octal 0177
  local bound = c_bind(listener, &address, (@cuint)(2 + #path + 1))
  c_umask(previous_mask)
  if bound ~= 0 then return 75 end
  if c_listen(listener, 8) ~= 0 then c_close(listener); c_unlink((@cstring)(path)); return 77 end

  local runtime: Runtime = {service = service, state = ServiceState.Planned, pidfd = -1, last_exit = -1}
  local exit_code: integer = 78
  local shutdown_client: cint = -1
  if spawn(&runtime, &argv, &child_mask) then
    exit_code, shutdown_client = serve(listener, shutdown_fd, &runtime, &argv, &child_mask)
  end

  c_close(listener)
  local stopped = stop_child(&runtime)
  c_unlink((@cstring)(path))
  c_close(shutdown_fd)
  if shutdown_client >= 0 then
    if stopped then write_all(shutdown_client, 'TR1\tOK\n')
    else write_all(shutdown_client, 'TR1\tERROR\tshutdown\n') end
    c_close(shutdown_client)
  end
  if not stopped then
    io.stderr:write('theseusd: failed to stop owned child\n')
    return 81
  end
  print('daemon-stopped', service.name)
  return exit_code
end

os.exit(main())
