-- Theseus native target planner.
require 'arg'
require 'io'
require 'os'
require 'src.theseus.graph'

local function selftest()
  local graph: NativeGraph
  graph.service_count = 1
  graph.services[0].name = 'service-a'
  graph.target_count = 1
  graph.targets[0].name = 'target-a'
  graph.targets[0].members = 'service-a'
  local plan: NativePlan
  assert(plan_native_target(&graph, 'target-a', &plan) == 0)
  assert(plan.count == 1 and plan.order[0] == 0 and plan.required[0])
  print('Theseus graph self-test passed')
end

if #arg == 1 and arg[1] == '--selftest' then selftest(); os.exit(0) end
if #arg ~= 1 then
  io.stderr:write('usage: theseus-graph TARGET\n')
  os.exit(64)
end
local path = os.getenv('THESEUS_GRAPH')
if #path == 0 then path = './build/graph.tsc' end
local graph: NativeGraph
if not load_native_graph(path, &graph) then os.exit(65) end
local plan: NativePlan
local code = plan_native_target(&graph, arg[1], &plan)
if code ~= 0 then os.exit(code) end
print('PLAN1', arg[1], plan.count)
for i: integer = 0, plan.count - 1 do
  print('plan', i + 1, graph.services[plan.order[i]].name)
end
